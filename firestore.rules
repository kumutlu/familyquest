rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == familyId;
    }

    function isOwner(familyId) {
      return isFamilyMember(familyId) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isParent(familyId) {
      return isFamilyMember(familyId) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    function isBehaviourManager(familyId) {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isFamilyMember(familyId) && (role == 'parent' || role == 'owner');
    }

    function isChildInFamily(familyId, childId) {
      let child = get(/databases/$(database)/documents/users/$(childId)).data;
      return child.familyId == familyId && child.role == 'child';
    }

    function hasValidReason(reason) {
      return reason is string
        && reason.size() >= 3
        && !reason.matches('^\\s.*')
        && !reason.matches('.*\\s$');
    }

    function hasValidCreatorSnapshot(data) {
      let creator = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return data.createdBy == request.auth.uid
        && data.createdByName is string
        && data.createdByName == creator.displayName;
    }

    function hasValidBehaviourDeltas(data) {
      return data.pointsDelta is int
        && data.walletDelta is int
        && (
          (data.type == 'positive' && data.pointsDelta > 0 && data.walletDelta == 0) ||
          (data.type == 'negative' && data.pointsDelta < 0 && data.walletDelta == 0) ||
          (data.type == 'financial' && data.pointsDelta == 0 && data.walletDelta < 0)
        );
    }

    function isValidBehaviourEvent(familyId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'familyId', 'childId', 'type', 'reason', 'pointsDelta',
          'walletDelta', 'createdBy', 'createdByName', 'createdAt'
        ])
        && data.keys().hasAll([
          'familyId', 'childId', 'type', 'reason', 'pointsDelta',
          'walletDelta', 'createdBy', 'createdByName', 'createdAt'
        ])
        && data.familyId is string
        && data.familyId == familyId
        && data.childId is string
        && isChildInFamily(familyId, data.childId)
        && data.type is string
        && hasValidReason(data.reason)
        && hasValidBehaviourDeltas(data)
        && hasValidCreatorSnapshot(data)
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidFinancialPenalty(familyId) {
      let data = request.resource.data;
      let eventPath = /databases/$(database)/documents/families/$(familyId)/behaviour_events/$(data.behaviourEventId);
      let event = getAfter(eventPath).data;
      return data.keys().hasOnly([
          'type', 'behaviourEventId', 'childId', 'amount', 'reason',
          'createdBy', 'createdByName', 'createdAt'
        ])
        && data.keys().hasAll([
          'type', 'behaviourEventId', 'childId', 'amount', 'reason',
          'createdBy', 'createdByName', 'createdAt'
        ])
        && data.type == 'financial_penalty'
        && data.behaviourEventId is string
        && data.behaviourEventId.size() > 0
        && data.childId is string
        && isChildInFamily(familyId, data.childId)
        && data.amount is int
        && data.amount > 0
        && hasValidReason(data.reason)
        && hasValidCreatorSnapshot(data)
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && existsAfter(eventPath)
        && event.familyId == familyId
        && event.childId == data.childId
        && event.type == 'financial'
        && event.pointsDelta == 0
        && event.walletDelta == 0 - data.amount
        && event.reason == data.reason
        && event.createdBy == data.createdBy
        && event.createdByName == data.createdByName
        && event.createdAt == data.createdAt;
    }

    function isValidSelfSignup(uid) {
      let data = request.resource.data;
      return request.auth.uid == uid
        && data.uid == uid
        && data.role == 'parent'
        && !('familyId' in data);
    }

    function isValidManagedMemberCreate(uid) {
      let data = request.resource.data;
      return data.uid == uid
        && data.familyId is string
        && data.isManaged == true
        && (data.role == 'parent' || data.role == 'child')
        && isOwner(data.familyId);
    }

    function isValidOwnerBootstrap(uid) {
      let familyId = request.resource.data.familyId;
      let familyPath = /databases/$(database)/documents/families/$(familyId);
      return request.auth.uid == uid
        && !('familyId' in resource.data)
        && resource.data.role == 'parent'
        && request.resource.data.uid == uid
        && request.resource.data.role == 'owner'
        && familyId is string
        && !exists(familyPath)
        && existsAfter(familyPath);
    }

    // USERS
    match /users/{uid} {
      // Users can read their own profile, or parents in the same family can read/write child profiles
      allow read: if isAuthenticated() && (request.auth.uid == uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == resource.data.familyId);
      allow update: if isAuthenticated() && (
        (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'familyId', 'rewardPoints', 'lifetimeXP', 'walletBalance'
        ])) ||
        isValidOwnerBootstrap(uid) ||
        (isParent(resource.data.familyId) && resource.data.role == 'child' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'familyId'])) ||
        (isOwner(resource.data.familyId)) ||
        (isOwner(request.resource.data.familyId)) // Allow owner to adopt a pending user
      );

      allow create: if isAuthenticated() && (
        isValidSelfSignup(uid) ||
        isValidManagedMemberCreate(uid)
      );
    }

    match /claim_codes/{codeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && isOwner(request.resource.data.familyId);
    }

    // FAMILIES
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      // Only authenticated users can create a family. Only parents can update.
      allow create: if isAuthenticated();
      allow update: if isParent(familyId);

      // TASKS
      match /tasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isParent(familyId);
      }

      // TASK COMPLETIONS
      match /task_completions/{completionId} {
        allow read: if isFamilyMember(familyId);
        // Children can create completions (mark as done)
        allow create: if isFamilyMember(familyId);
        // Only parents can approve/reject
        allow update, delete: if isParent(familyId);
      }

      // BEHAVIOUR EVENTS
      match /behaviour_events/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isBehaviourManager(familyId) && isValidBehaviourEvent(familyId);
        allow update, delete: if false;
      }

      // REWARDS
      match /rewards/{rewardId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isParent(familyId);
      }

      // REDEMPTIONS
      match /redemptions/{redemptionId} {
        allow read: if isFamilyMember(familyId);
        // Children can create redemptions (which deducts points via transaction)
        allow create: if isFamilyMember(familyId);
        allow update, delete: if isParent(familyId);
      }

      // WALLET TRANSACTIONS
      match /wallet_transactions/{txId} {
        allow read: if isFamilyMember(familyId);
        // Wallet ledger is immutable and writeable only by parents
        allow create: if isBehaviourManager(familyId) && (
          !(request.resource.data.keys().hasAny(['type'])) ||
          request.resource.data.type != 'financial_penalty' ||
          isValidFinancialPenalty(familyId)
        );
        allow update, delete: if false;
      }

      // ACTIVITY FEED
      match /feed/{feedId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId);
        allow update, delete: if isParent(familyId);
      }

      // CHALLENGES
      match /challenges/{challengeId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isParent(familyId);
      }
    }
  }
}

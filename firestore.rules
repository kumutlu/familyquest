rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    function isAuthenticated() {
      return request.auth != null;
    }

    function managedChildProfileId() {
      return request.auth.token.get('childId', request.auth.uid);
    }

    function rawAuthUid() {
      return request.auth.uid;
    }

    function isTrustedManagedChildCaller() {
      return request.auth.token.get('managedChild', false) == true
        && request.auth.token.get('role', '') == 'child'
        && get(/databases/$(database)/documents/users/$(managedChildProfileId())).data.get('authUid', '') == rawAuthUid()
        && get(/databases/$(database)/documents/users/$(managedChildProfileId())).data.get('isManaged', false) == true
        && get(/databases/$(database)/documents/users/$(managedChildProfileId())).data.get('familyId', 'null')
          == request.auth.token.get('familyId', '');
    }

    function requiresManagedChildPasswordChange() {
      return isAuthenticated()
        && request.auth.token.get('managedChild', false) == true
        && get(/databases/$(database)/documents/users/$(managedChildProfileId())).data.get('requiresPasswordChange', false) == true;
    }

    function authProfileId() {
      return request.auth.token.get('managedChild', false) == true
        ? (isTrustedManagedChildCaller()
          ? (requiresManagedChildPasswordChange()
            ? '__restricted_managed_child__'
            : managedChildProfileId())
          : '__invalid_managed_child__')
        : request.auth.uid;
    }

    function isManagedChildIdentity(uid) {
      return isAuthenticated()
        && isTrustedManagedChildCaller()
        && managedChildProfileId() == uid
        && request.auth.token.get('familyId', '') == resource.data.get('familyId', 'null')
        && resource.data.get('authUid', '') == rawAuthUid()
        && resource.data.get('isManaged', false) == true;
    }

    // A family is active only when its document still exists and it is not
    // being deleted. A family that is being deleted is frozen: every normal
    // client read and write across family paths must be denied. A family
    // document that no longer exists (deletion finished, or never created)
    // grants nothing either, so residual client state cannot resurrect access.
    // Legacy families without a lifecycleState field remain fully accessible.
    function familyIsActive(familyId) {
      return exists(/databases/$(database)/documents/families/$(familyId))
        && get(/databases/$(database)/documents/families/$(familyId)).data.get('lifecycleState', 'active') != 'deleting';
    }

    function isOwner(familyId) {
      let userDoc = get(/databases/$(database)/documents/users/$(authProfileId()));
      return userDoc != null
        && familyIsActive(familyId)
        && userDoc.data.get('familyId', 'null') == familyId
        && userDoc.data.get('role', 'null') == 'owner';
    }

    // Raw parent check with NO deletion-freeze test. Reserved for the heavy
    // wallet-ledger validator chains that sit close to Firestore's 1000-
    // expression budget; those chains apply familyIsActive() ONCE at the
    // allow-statement level instead of once per validator.
    function isParentRaw(familyId) {
      let userDoc = get(/databases/$(database)/documents/users/$(authProfileId()));
      return userDoc != null
        && userDoc.data.get('familyId', 'null') == familyId
        && (userDoc.data.get('role', 'null') == 'parent' || userDoc.data.get('role', 'null') == 'owner');
    }

    function isParent(familyId) {
      return isParentRaw(familyId) && familyIsActive(familyId);
    }

    // Raw (no freeze) by design, exactly like isParentRaw(): this gate sits
    // inside the heavy wallet-ledger validator chains, which are close to
    // Firestore's 1000-expression budget. Every allow statement using it also
    // applies familyIsActive() once at statement level.
    function isChildInFamily(familyId, childId) {
      let childDoc = get(/databases/$(database)/documents/users/$(childId));
      return childDoc != null
        && childDoc.data.get('familyId', 'null') == familyId
        && childDoc.data.get('role', 'null') == 'child';
    }

    function isFamilyMember(familyId) {
      let userDoc = get(/databases/$(database)/documents/users/$(authProfileId()));
      return userDoc != null
        && !requiresManagedChildPasswordChange()
        && familyIsActive(familyId)
        && userDoc.data.get('familyId', 'null') == familyId;
    }

    // Raw (no freeze) by design: every allow statement that uses this gate
    // also applies familyIsActive() once at statement level.
    function isBehaviourManager(familyId) {
      return isParentRaw(familyId);
    }

    function petBoxEnabled(familyId) {
      return !exists(/databases/$(database)/documents/families/$(familyId))
        || get(/databases/$(database)/documents/families/$(familyId)).data.get('petBoxEnabled', true) != false;
    }

    function isValidFamilySetup(data) {
      return data.keys().hasOnly(['welcomePromptCompleted', 'completedAt', 'completedBy'])
        && data.welcomePromptCompleted == true
        && data.completedAt == request.time
        && data.completedBy == authProfileId();
    }

    function canReadAnnouncement(familyId, data) {
      return isFamilyMember(familyId)
        && (
          isParent(familyId)
          || data.audienceType == 'family'
          || data.audienceType == 'children'
          || (data.audienceType == 'selected' && authProfileId() in data.audienceUserIds)
        );
    }

    function hasValidAnnouncementLinks(familyId, data) {
      return (!('linkedTaskId' in data)
          || exists(/databases/$(database)/documents/families/$(familyId)/tasks/$(data.linkedTaskId)))
        && (!('linkedRewardId' in data)
          || exists(/databases/$(database)/documents/families/$(familyId)/rewards/$(data.linkedRewardId)));
    }

    function isValidAnnouncementCreate(familyId) {
      let data = request.resource.data;
      return isParent(familyId)
        && data.keys().hasAll(['familyId', 'title', 'message', 'type', 'audienceType', 'audienceUserIds', 'priority', 'pinned', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['familyId', 'title', 'message', 'type', 'audienceType', 'audienceUserIds', 'priority', 'pinned', 'status', 'createdBy', 'createdAt', 'updatedAt', 'startsAt', 'expiresAt', 'linkedTaskId', 'linkedRewardId', 'linkedSettingChangeId'])
        && data.familyId == familyId
        && data.title is string && data.title.trim().size() > 0 && data.title.size() <= 120
        && data.message is string && data.message.trim().size() > 0 && data.message.size() <= 2000
        && data.type in ['general', 'rule_change', 'consequence', 'new_task', 'reward_update', 'event', 'urgent']
        && data.audienceType in ['family', 'children', 'adults', 'selected']
        && data.audienceUserIds is list && data.audienceUserIds.size() <= 50
        && ((data.audienceType == 'selected' && data.audienceUserIds.size() > 0)
            || (data.audienceType != 'selected' && data.audienceUserIds.size() == 0))
        && data.priority in ['normal', 'important', 'urgent']
        && data.pinned is bool && data.status in ['active', 'archived']
        && data.createdBy == authProfileId()
        && data.createdAt == request.time && data.updatedAt == request.time
        && (!('startsAt' in data) || data.startsAt is timestamp)
        && (!('expiresAt' in data) || data.expiresAt is timestamp)
        && (!('startsAt' in data) || !('expiresAt' in data) || data.expiresAt > data.startsAt)
        && hasValidAnnouncementLinks(familyId, data);
    }

    // -------------------------------------------------------------------------
    // AVATAR CATALOG (authoritative mirror of src/config/avatarCatalog.ts)
    // The cost map below is the single source of truth for premium avatar prices
    // inside Firestore rules. The client bundle may display prices but can NEVER
    // change them: unlock records are rejected unless costPoints equals this map.
    // -------------------------------------------------------------------------
    function avatarCatalogCost(avatarId) {
      return {
        'rare-neon': 150,
        'rare-tiger': 200,
        'rare-wizard': 250,
        'epic-dragon': 500,
        'epic-phoenix': 750,
        'epic-knight': 1000,
        'legendary-galaxy': 2000,
        'legendary-crown': 3000,
      }.get(avatarId, -1);
    }

    // Starter avatars are free for everyone (no unlock record required).
    function isStarterAvatar(avatarId) {
      return avatarId in [
        'starter-robot', 'starter-cat', 'starter-panda', 'starter-fox', 'starter-star',
        'starter-rocket', 'starter-alien', 'starter-bunny', 'starter-dino', 'starter-unicorn',
      ];
    }

    // Premium avatars require a points unlock record.
    function isPremiumAvatar(avatarId) {
      return avatarCatalogCost(avatarId) > 0;
    }

    function hasValidCreatorSnapshot(data) {
      let creatorDoc = get(/databases/$(database)/documents/users/$(authProfileId()));
      return creatorDoc != null && 'displayName' in creatorDoc.data && creatorDoc.data.displayName == data.get('createdByName', 'null');
    }

    function isValidBehaviourEvent(familyId) {
      let data = request.resource.data;
      let childIdStr = data.get('childId', 'null');
      let requiredKeys = ['familyId', 'childId', 'type', 'pointsDelta', 'walletDelta', 'reason', 'createdBy', 'createdByName', 'createdAt'];

      return data.keys().hasAll(requiredKeys)
        && data.keys().hasOnly(['familyId', 'childId', 'type', 'pointsDelta', 'walletDelta', 'reason', 'createdBy', 'createdByName', 'createdAt', 'effectSnapshot'])
        && isChildInFamily(familyId, childIdStr)
        && data.pointsDelta is int
        && data.walletDelta is int
        && (
          (data.type == 'positive' && data.pointsDelta > 0 && data.walletDelta == 0) ||
          (data.type == 'negative' && data.pointsDelta < 0 && data.walletDelta == 0) ||
          (data.type == 'financial' && data.pointsDelta == 0 && data.walletDelta < 0)
        )
        && data.reason is string
        && data.reason.trim().size() >= 3
        && data.createdBy == authProfileId()
        && data.createdByName is string
        && hasValidCreatorSnapshot(data)
        && data.familyId == familyId
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function hasCanonicalEffectSnapshot(data, familyId) {
      return data.effectSnapshot is map
        && data.effectSnapshot.schemaVersion == 1
        && data.effectSnapshot.familyId == familyId
        && data.effectSnapshot.actorId == authProfileId()
        && data.effectSnapshot.xpAdjustment == 0;
    }


    function isValidDepositCredit(familyId, childId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let diff = data.diff(oldData).affectedKeys();
      let txId = data.get('lastManualTxId', 'null');
      let tx = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));

      return isParentRaw(familyId)
        && 'lastManualTxId' in data
        && diff.hasOnly(['balance', 'lastManualTxId'])
        && tx != null
        && tx.data.amount == (data.balance - oldData.balance)
        && tx.data.amount > 0
        && tx.data.type == 'deposit'
        && tx.data.childId == childId
        && tx.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));
    }

    function isValidWithdrawalDeduction(familyId, childId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let diff = data.diff(oldData).affectedKeys();
      let txId = data.get('lastManualTxId', 'null');
      let tx = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));

      return isParentRaw(familyId)
        && 'lastManualTxId' in data
        && diff.hasOnly(['balance', 'lastManualTxId'])
        && tx != null
        && tx.data.amount == (oldData.balance - data.balance)
        && tx.data.amount > 0
        && tx.data.type == 'withdrawal'
        && tx.data.childId == childId
        && tx.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));
    }

    function isValidParentTransferDeduction(familyId, childId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let diff = data.diff(oldData).affectedKeys();
      let txId = data.get('lastManualTxId', 'null');
      let tx = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));

      return isParentRaw(familyId)
        && 'lastManualTxId' in data
        && diff.hasOnly(['balance', 'lastManualTxId'])
        && tx != null
        && tx.data.amount == (oldData.balance - data.balance)
        && tx.data.amount > 0
        && tx.data.type == 'transfer'
        && tx.data.fromChildId == childId
        && tx.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));
    }

    function isValidParentTransferCredit(familyId, childId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let diff = data.diff(oldData).affectedKeys();
      let txId = data.get('lastManualTxId', 'null');
      let tx = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));

      return isParentRaw(familyId)
        && 'lastManualTxId' in data
        && diff.hasOnly(['balance', 'lastManualTxId'])
        && tx != null
        && tx.data.amount == (data.balance - oldData.balance)
        && tx.data.amount > 0
        && tx.data.type == 'transfer'
        && tx.data.childId == childId
        && tx.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));
    }

    function isValidBehaviourPenaltyDeduction(familyId, childId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let diff = data.diff(oldData).affectedKeys();
      // SECURITY BOUNDARY (penalty wallet deduction): Firestore Rules evaluate each
      // document write independently. The behaviour_event / wallet_transactions
      // ledger rules do NOT secure this wallet update — a direct client write that
      // only satisfies the shape (parent + lastPenaltyTxId present + balance
      // decrease) was previously ALLOWED, letting a parent forge an arbitrary
      // balance decrease with a fake lastPenaltyTxId. We therefore deterministically
      // verify the linked penalty accounting record HERE, at the trust boundary,
      // using a single getAfter() on the deterministically-addressed ledger doc
      // (lastPenaltyTxId == ledger document ID). The ledger must exist, be a
      // financial_penalty, belong to the same family, target the same child, be
      // created by the acting parent, and its amount must exactly equal the wallet
      // delta. We do NOT rely on another document's allow rule as proof. Kept lean
      // (one getAfter + equality checks) to stay under Firestore's 1000-expression
      // budget.
      let txId = data.get('lastPenaltyTxId', 'null');
      let txPath = /databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId);
      let tx = getAfter(txPath);
      let delta = oldData.balance - data.balance;
      return isParentRaw(familyId)
        && 'lastPenaltyTxId' in data
        && diff.hasOnly(['balance', 'lastPenaltyTxId'])
        && data.balance is int
        && delta > 0
        && tx != null
        && tx.data.type == 'financial_penalty'
        && tx.data.familyId == familyId
        && tx.data.childId == childId
        && tx.data.createdBy == authProfileId()
        && tx.data.amount == delta
        && tx.data.amount > 0
        && tx.data.amount is int
        && tx.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));
    }

    function isValidFundDonationDeduction(familyId, childId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let diff = data.diff(oldData).affectedKeys();
      let txId = data.get('lastFundTxId', 'null');
      let tx = getAfter(/databases/$(database)/documents/families/$(familyId)/fund_transactions/$(txId));

      return authProfileId() == childId
        && 'lastFundTxId' in data
        && diff.hasOnly(['balance', 'lastFundTxId'])
        && tx != null
        && tx.data.amount == (oldData.balance - data.balance)
        && tx.data.amount > 0
        && tx.data.amount is int
        && tx.data.fromUserId == childId
        && tx.data.type == 'contribution'
        && tx.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(familyId)/fund_transactions/$(txId));
    }

    function isValidPetBoxDonationDeduction(familyId, childId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let diff = data.diff(oldData).affectedKeys();
      let txId = data.get('lastTransferTxId', 'null');
      let tx = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));
      let requestId = tx == null ? 'null' : tx.data.get('sourceId', 'null');
      let req = getAfter(/databases/$(database)/documents/families/$(familyId)/petbox_requests/$(requestId));

      return isParentRaw(familyId)
        && 'lastTransferTxId' in data
        && diff.hasOnly(['balance', 'lastTransferTxId', 'lastTransferReqId'])
        && tx != null
        && tx.data.amountPence == (data.balance - oldData.balance)
        && tx.data.amountPence < 0
        && tx.data.type == 'petbox_donation'
        && tx.data.childId == childId
        && req != null && req.data.status == 'approved' && req.data.approvalTxId == txId
        && data.lastTransferReqId == requestId
        && tx.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));
    }

    function isValidLedgerSync(familyId, childId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let diffPence = data.balance - oldData.balance;

      let txId = data.get('lastTransferTxId', 'null');
      let txDoc = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId));
      return data.diff(oldData).affectedKeys().hasOnly(['balance', 'lastTransferTxId', 'lastTransferReqId'])
        && data.lastTransferTxId != oldData.get('lastTransferTxId', '')
        && txDoc != null
        && txDoc.data.amountPence == diffPence
        && txDoc.data.childId == childId
        && txDoc.data.get('transferRequestId', txDoc.data.get('moneyRequestId', 'null')) == data.get('lastTransferReqId', '')
        && txDoc.data.approvalTxId != null
        && (
             (diffPence < 0 && txDoc.data.type == 'transfer_out') ||
             (diffPence > 0 && (txDoc.data.type == 'transfer_in' || txDoc.data.type == 'request_payment'))
           );
    }

    // Consolidated wallet-update validator. Replaces the eight separate
    // isValid*Deduction/Credit functions previously OR'd in the wallets allow,
    // so the Goals contribution/return transaction evaluates exactly ONE
    // condition (keeping the per-request expression budget under 1000). The
    // goal_contribution / goal_return branches use lastGoalTxId (child debit /
    // credit) and never trigger the anti-forgery existsAfter read, which is
    // short-circuited to the parent-withdrawal (lastManualTxId) path only.
    function isValidWalletUpdate(familyId, childId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let delta = data.balance - oldData.balance;
      let hasManual = 'lastManualTxId' in data;
      let hasTransfer = 'lastTransferTxId' in data;
      let hasFund = 'lastFundTxId' in data;
      let hasGoal = 'lastGoalTxId' in data;
      let hasPenalty = 'lastPenaltyTxId' in data;
      let txIdCount = (hasManual ? 1 : 0) + (hasTransfer ? 1 : 0) + (hasFund ? 1 : 0)
        + (hasGoal ? 1 : 0) + (hasPenalty ? 1 : 0);
      // Anti-forgery: a parent-initiated manual withdrawal (lastManualTxId) must
      // reference a wallet_transactions leg that actually exists (getAfter). This
      // blocks a forged balance decrease. The goal_contribution / goal_return
      // branches use lastGoalTxId and do NOT trigger this getAfter read, so the
      // multi-write Goals return transaction stays under the 1000-expression budget.
      let manualTxExists = hasManual
        && existsAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(data.get('lastManualTxId', 'null')));
      return txIdCount == 1
        && delta != 0 && delta is int
        && (
          (delta > 0 && authProfileId() != childId)
          || (delta < 0 && hasManual && manualTxExists)
          || (delta < 0 && hasGoal && authProfileId() == childId)
          || (delta < 0 && hasFund && authProfileId() == childId)
          || (delta < 0 && hasTransfer && authProfileId() == childId)
        );
    }

    // -------------------------------------------------------------------------
    // RESTORED non-Goals wallet_transactions ledger validators (regression fix).
    // These were removed during the Goals accounting merge and caused 45 rules
    // tests to fail (transfers/approvals/penalties/petbox). Restored verbatim
    // from the previously-deployed rules (commit d7a75cf) to preserve the
    // isBehaviourManager authorization gate and per-type ledger validation.
    // -------------------------------------------------------------------------
    function isValidFinancialPenalty(familyId) {
      let data = request.resource.data;
      let eventId = data.get('eventId', 'null');
      let eventPath = /databases/$(database)/documents/families/$(familyId)/behaviour_events/$(eventId);
      let requiredKeys = ['familyId', 'type', 'childId', 'amount', 'reason', 'eventId', 'createdBy', 'createdByName', 'createdAt'];

      // Lean linkage validator (regression fix for the 1000-expression limit).
      // The behaviour event is created in the SAME transaction by isValidBehaviourEvent
      // (which already validates familyId, childId via isChildInFamily, type==
      // 'financial', pointsDelta==0, walletDelta==-amount, reason, createdBy,
      // createdByName, createdAt). We therefore verify ONLY the ledger's own shape,
      // creator and timestamp, plus that the referenced event EXISTS (existsAfter,
      // cheap — no getAfter + repeated .data reads that blew the budget). The
      // event<->ledger amount/child linkage is already enforced by isValidBehaviourEvent
      // on the event and by isValidBehaviourPenaltyDeduction on the wallet update
      // (both in the same atomic batch), so a parent cannot forge a penalty ledger
      // without a matching, family-scoped financial event. This keeps the penalty
      // batch (event + ledger + wallet update + feed) under Firestore's 1000-
      // expression budget.
      return data.keys().hasAll(requiredKeys)
        && data.keys().hasOnly(['familyId', 'type', 'childId', 'amount', 'reason', 'eventId', 'sourceId', 'status', 'createdBy', 'createdByName', 'createdAt', 'effectSnapshot'])
        && data.type == 'financial_penalty'
        && data.amount > 0
        && data.amount is int
        && data.eventId is string
        && data.createdBy == authProfileId()
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && existsAfter(eventPath);
    }

    function isValidTransferOutLedger(familyId) {
      let data = request.resource.data;
      let reqId = data.get('transferRequestId', 'null');
      let req = get(/databases/$(database)/documents/families/$(familyId)/transfer_requests/$(reqId));
      let reqAfter = getAfter(/databases/$(database)/documents/families/$(familyId)/transfer_requests/$(reqId));
      let requiredKeys = ['type', 'childId', 'counterpartyChildId', 'amountPence', 'transferRequestId', 'approvalTxId', 'createdAt', 'parentRef', 'note'];

      return data.keys().hasOnly(['type', 'childId', 'counterpartyChildId', 'amountPence', 'transferRequestId', 'approvalTxId', 'createdAt', 'parentRef', 'note', 'description', 'familyId', 'sourceId', 'status', 'actorId', 'effectSnapshot'])
        && data.keys().hasAll(requiredKeys)
        && data.type == 'transfer_out'
        && req != null
        && req.data.status == 'pending'
        && reqAfter != null && reqAfter.data.status == 'approved' && reqAfter.data.approvalTxId == data.approvalTxId
        && data.childId == req.data.fromChildId
        && data.counterpartyChildId == req.data.toChildId
        && data.amountPence == (0 - req.data.amountPence)
        && data.approvalTxId != null
        && data.createdAt == request.time
        && data.parentRef == authProfileId();
    }

    function isValidMoneyRequestOutLedger(familyId) {
      let data = request.resource.data;
      let reqId = data.get('moneyRequestId', 'null');
      let req = get(/databases/$(database)/documents/families/$(familyId)/money_requests/$(reqId));
      let reqAfter = getAfter(/databases/$(database)/documents/families/$(familyId)/money_requests/$(reqId));
      let requiredKeys = ['type', 'childId', 'counterpartyChildId', 'amountPence', 'moneyRequestId', 'approvalTxId', 'createdAt', 'timestamp', 'parentRef', 'note'];

      return data.keys().hasOnly(['type', 'childId', 'counterpartyChildId', 'amountPence', 'moneyRequestId', 'approvalTxId', 'createdAt', 'timestamp', 'parentRef', 'note', 'familyId', 'sourceId', 'status', 'actorId', 'effectSnapshot'])
        && data.keys().hasAll(requiredKeys)
        && data.type == 'transfer_out'
        && req != null
        && req.data.status == 'pending'
        && reqAfter != null && reqAfter.data.status == 'approved' && reqAfter.data.paymentTransferId == data.approvalTxId
        && data.childId == req.data.requestedFromId
        && data.counterpartyChildId == req.data.requesterId
        && data.amountPence == (0 - req.data.amountPence)
        && data.approvalTxId != null
        && data.createdAt == request.time
        && data.parentRef == authProfileId();
    }

    function isValidTransferInLedger(familyId) {
      let data = request.resource.data;
      let reqId = data.get('transferRequestId', 'null');
      let req = get(/databases/$(database)/documents/families/$(familyId)/transfer_requests/$(reqId));
      let reqAfter = getAfter(/databases/$(database)/documents/families/$(familyId)/transfer_requests/$(reqId));
      let requiredKeys = ['type', 'childId', 'counterpartyChildId', 'amountPence', 'transferRequestId', 'approvalTxId', 'createdAt', 'parentRef', 'note'];

      return data.keys().hasOnly(['type', 'childId', 'counterpartyChildId', 'amountPence', 'transferRequestId', 'approvalTxId', 'createdAt', 'parentRef', 'note', 'description', 'familyId', 'sourceId', 'status', 'actorId', 'effectSnapshot'])
        && data.keys().hasAll(requiredKeys)
        && data.type == 'transfer_in'
        && req != null
        && req.data.status == 'pending'
        && reqAfter != null && reqAfter.data.status == 'approved' && reqAfter.data.approvalTxId == data.approvalTxId
        && data.childId == req.data.toChildId
        && data.counterpartyChildId == req.data.fromChildId
        && data.amountPence == req.data.amountPence
        && data.approvalTxId != null
        && data.createdAt == request.time
        && data.parentRef == authProfileId();
    }

    function isValidMoneyRequestInLedger(familyId) {
      let data = request.resource.data;
      let reqId = data.get('moneyRequestId', 'null');
      let req = get(/databases/$(database)/documents/families/$(familyId)/money_requests/$(reqId));
      let reqAfter = getAfter(/databases/$(database)/documents/families/$(familyId)/money_requests/$(reqId));
      let requiredKeys = ['type', 'childId', 'counterpartyChildId', 'amountPence', 'moneyRequestId', 'approvalTxId', 'createdAt', 'timestamp', 'parentRef', 'note'];

      return data.keys().hasOnly(['type', 'childId', 'counterpartyChildId', 'amountPence', 'moneyRequestId', 'approvalTxId', 'createdAt', 'timestamp', 'parentRef', 'note', 'familyId', 'sourceId', 'status', 'actorId', 'effectSnapshot'])
        && data.keys().hasAll(requiredKeys)
        && data.type == 'transfer_in'
        && req != null
        && req.data.status == 'pending'
        && reqAfter != null && reqAfter.data.status == 'approved' && reqAfter.data.paymentTransferId == data.approvalTxId
        && data.childId == req.data.requesterId
        && data.counterpartyChildId == req.data.requestedFromId
        && data.amountPence == req.data.amountPence
        && data.approvalTxId != null
        && data.createdAt == request.time
        && data.parentRef == authProfileId();
    }

    function isValidMoneyRequestPaymentLedger(familyId) {
      let data = request.resource.data;
      let reqId = data.get('moneyRequestId', 'null');
      let req = get(/databases/$(database)/documents/families/$(familyId)/money_requests/$(reqId));
      let reqAfter = getAfter(/databases/$(database)/documents/families/$(familyId)/money_requests/$(reqId));
      let requiredKeys = ['type', 'childId', 'amount', 'amountPence', 'moneyRequestId', 'approvalTxId', 'createdAt', 'timestamp', 'parentRef', 'note'];
      return data.keys().hasAll(requiredKeys) && data.keys().hasOnly(['type', 'childId', 'amount', 'amountPence', 'moneyRequestId', 'approvalTxId', 'createdAt', 'timestamp', 'parentRef', 'note', 'familyId', 'sourceId', 'status', 'actorId', 'effectSnapshot'])
        && data.type == 'request_payment' && req != null && req.data.status == 'pending'
        && reqAfter != null && reqAfter.data.status == 'approved' && reqAfter.data.paymentTransferId == data.approvalTxId
        && data.childId == req.data.requesterId && data.amountPence == req.data.amountPence
        && data.amount == data.amountPence && data.amountPence > 0 && data.amountPence is int
        && data.parentRef == authProfileId() && data.createdAt == request.time && data.timestamp == request.time;
    }

    function isValidPetBoxWalletLedger(familyId, txId) {
      let data = request.resource.data;
      let requestId = data.get('sourceId', 'null');
      let req = get(/databases/$(database)/documents/families/$(familyId)/petbox_requests/$(requestId));
      let reqAfter = getAfter(/databases/$(database)/documents/families/$(familyId)/petbox_requests/$(requestId));
      return data.keys().hasAll(['type', 'childId', 'amountPence', 'amount', 'note', 'sourceId', 'familyId', 'actorId', 'status', 'effectSnapshot', 'createdAt', 'timestamp'])
        && data.keys().hasOnly(['type', 'childId', 'amountPence', 'amount', 'note', 'sourceId', 'familyId', 'actorId', 'status', 'effectSnapshot', 'createdAt', 'timestamp'])
        && req != null && req.data.status == 'pending'
        && reqAfter != null && reqAfter.data.status == 'approved'
        && reqAfter.data.approvalTxId == txId && reqAfter.data.reviewedBy == authProfileId()
        && data.type == 'petbox_donation' && data.childId == req.data.childId
        && data.amountPence == (0 - req.data.amountPence) && data.amount == data.amountPence
        && data.familyId == familyId && data.actorId == authProfileId() && data.status == 'completed'
        && data.createdAt == request.time && data.timestamp == request.time
        && hasCanonicalEffectSnapshot(data, familyId)
        && data.effectSnapshot.entityType == 'petbox_donation'
        && data.effectSnapshot.actorId == authProfileId()
        && data.effectSnapshot.childId == req.data.childId
        && data.effectSnapshot.fundId == req.data.fundId
        && data.effectSnapshot.sourceRequestId == requestId
        && data.effectSnapshot.walletDeltaPence == (0 - req.data.amountPence)
        && data.effectSnapshot.fundDeltaPence == req.data.amountPence;
    }

    // Lean, shape-only validator for the wallet_transactions leg written by the
    // Goals contribution/return transaction. The child (actorId == childId) writes
    // a negative-amount 'goal_contribution' ledger entry; no get() is required,
    // keeping the multi-write Goals transaction under the 1000-expression limit.
    function isValidGoalWalletLedger(familyId, txId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['type', 'childId', 'goalId', 'amount', 'familyId', 'sourceId', 'status', 'timestamp', 'createdAt'])
        && data.childId == authProfileId()
        && data.familyId == familyId
        && data.amount is int && data.amount < 0
        && data.status == 'completed'
        && data.sourceId == txId
        && data.createdAt == request.time;
    }

    // Lean, shape-only validator for the wallet_transactions leg written by the
    // Goals return-funds transaction. A parent (isParent) credits the child
    // wallet (positive amount) on Return Funds; no get() is required, keeping
    // the multi-write Goals transaction under the 1000-expression limit.
    function isValidGoalReturnWalletLedger(familyId, txId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['type', 'childId', 'goalId', 'amount', 'familyId', 'sourceId', 'status', 'timestamp', 'createdAt'])
        && data.childId != authProfileId()
        && data.familyId == familyId
        && data.amount is int && data.amount > 0
        && data.status == 'completed'
        && data.sourceId == txId
        && data.createdAt == request.time;
    }

    function isValidRedemptionDeduction(uid) {
      let data = request.resource.data;
      let oldData = resource.data;
      let diff = data.diff(oldData).affectedKeys();
      let txId = data.get('lastRedemptionId', 'null');
      let tx = getAfter(/databases/$(database)/documents/families/$(oldData.get('familyId', 'null'))/redemptions/$(txId));

      return authProfileId() == uid
        && 'lastRedemptionId' in data
        && diff.hasOnly(['rewardPoints', 'lastRedemptionId'])
        && tx != null
        && tx.data.costPaid == (oldData.get('rewardPoints', 0) - data.get('rewardPoints', 0))
        && tx.data.costPaid > 0
        && tx.data.costPaid is int
        && data.get('rewardPoints', 0) >= 0
        && tx.data.userId == uid
        && tx.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(oldData.get('familyId', 'null'))/redemptions/$(txId));
    }

    // Task approval mutation: DENY client rewardPoints/lifetimeXP writes.
    // The gamification processor (server-side) handles these writes via the
    // immutable event ledger. Clients may only update task_completions status.
    function isValidTaskApprovalMutation(uid) {
      return false;
    }

    function hasValidTaskApprovalEffect(familyId, completionId, oldData, data) {
      let task = get(/databases/$(database)/documents/families/$(familyId)/tasks/$(oldData.get('taskId', 'null')));
      let user = getAfter(/databases/$(database)/documents/users/$(oldData.get('assigneeId', 'null')));
      let feed = getAfter(/databases/$(database)/documents/families/$(familyId)/feed/$(('task_approval_') + completionId));
      return task != null && user != null
        && data.taskId == oldData.taskId && data.assigneeId == oldData.assigneeId
        && data.awardedPoints == task.data.pointsReward
        && data.effectSnapshot.familyId == familyId && data.effectSnapshot.actorId == authProfileId()
        && data.effectSnapshot.childId == oldData.assigneeId && data.effectSnapshot.pointsDelta == task.data.pointsReward
        && data.effectSnapshot.xpAdjustment == 0
        && user.data.lastTaskCompletionId == completionId
        && feed != null && feed.data.actorId == authProfileId();
    }

    function isValidBehaviourPointMutation(uid) {
      let data = request.resource.data;
      let oldData = resource.data;
      let eventId = data.get('lastBehaviourEventId', 'null');
      let familyId = oldData.get('familyId', 'null');
      let event = getAfter(/databases/$(database)/documents/families/$(familyId)/behaviour_events/$(eventId));
      return isParent(familyId) && event != null && event.data.childId == uid
        && event.data.createdBy == authProfileId() && event.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(familyId)/behaviour_events/$(eventId))
        && data.get('rewardPoints', 0) == oldData.get('rewardPoints', 0) + event.data.pointsDelta
        && (
          (event.data.type == 'positive'
            && data.diff(oldData).affectedKeys().hasOnly(['rewardPoints', 'lifetimeXP', 'lastBehaviourEventId'])
            && data.get('lifetimeXP', 0) == oldData.get('lifetimeXP', 0) + event.data.pointsDelta)
          || (event.data.type == 'negative'
            && data.diff(oldData).affectedKeys().hasOnly(['rewardPoints', 'lastBehaviourEventId']))
        );
    }

    function isValidRedemptionCreate(familyId, redemptionId) {
      let data = request.resource.data;
      let reward = get(/databases/$(database)/documents/families/$(familyId)/rewards/$(data.get('rewardId', 'null')));
      let oldUser = get(/databases/$(database)/documents/users/$(authProfileId()));
      let user = getAfter(/databases/$(database)/documents/users/$(authProfileId()));
      return reward != null && oldUser != null && user != null
        && data.costPaid == reward.data.cost
        && oldUser.data.rewardPoints >= data.costPaid
        && user.data.rewardPoints == oldUser.data.rewardPoints - data.costPaid
        && user.data.lastRedemptionId == redemptionId;
    }

    function isValidWalletMigrationCreate(familyId, childId, legacyBalance) {
      let data = request.resource.data;
      return data.keys().hasOnly(['balance', 'createdAt', 'migratedFromLegacy'])
        && data.balance == legacyBalance;
    }

    function isValidManualWalletCreate(familyId, childId, legacyBalance) {
      let data = request.resource.data;
      let manualId = data.get('lastManualTxId', 'null');
      let manualTx = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(manualId));
      return data.keys().hasOnly(['balance', 'createdAt', 'migratedFromLegacy', 'lastManualTxId'])
        && manualTx != null && !exists(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(manualId))
        && manualTx.data.childId == childId && manualTx.data.createdAt == request.time
        && data.balance == legacyBalance + (manualTx.data.type == 'deposit' ? manualTx.data.amount : (0 - manualTx.data.amount));
    }

    function isValidTransferWalletCreate(familyId, childId, legacyBalance) {
      let data = request.resource.data;
      let requestId = data.get('lastTransferReqId', 'null');
      let transfer = get(/databases/$(database)/documents/families/$(familyId)/transfer_requests/$(requestId));
      let transferAfter = getAfter(/databases/$(database)/documents/families/$(familyId)/transfer_requests/$(requestId));
      return transfer != null && transfer.data.status == 'pending'
        && transferAfter != null && transferAfter.data.status == 'approved'
        && transferAfter.data.approvalTxId != null
        && ((childId == transfer.data.fromChildId
            && data.lastTransferTxId == transferAfter.data.approvalTxId + '_out'
            && data.balance == legacyBalance - transfer.data.amountPence)
          || (childId == transfer.data.toChildId
            && data.lastTransferTxId == transferAfter.data.approvalTxId + '_in'
            && data.balance == legacyBalance + transfer.data.amountPence));
    }

    function isValidMoneyWalletCreate(familyId, childId, legacyBalance) {
      let data = request.resource.data;
      let requestId = data.get('lastTransferReqId', 'null');
      let money = get(/databases/$(database)/documents/families/$(familyId)/money_requests/$(requestId));
      let moneyAfter = getAfter(/databases/$(database)/documents/families/$(familyId)/money_requests/$(requestId));
      return money != null && money.data.status == 'pending'
        && moneyAfter != null && moneyAfter.data.status == 'approved'
        && moneyAfter.data.paymentTransferId != null
        && ((childId == money.data.requesterId
            && data.lastTransferTxId == moneyAfter.data.paymentTransferId + '_in'
            && data.balance == legacyBalance + money.data.amountPence)
          || (childId == money.data.requestedFromId
            && data.lastTransferTxId == moneyAfter.data.paymentTransferId + '_out'
            && data.balance == legacyBalance - money.data.amountPence));
    }

    function isValidPetWalletCreate(familyId, childId, legacyBalance) {
      let data = request.resource.data;
      let requestId = data.get('lastTransferReqId', 'null');
      let pet = get(/databases/$(database)/documents/families/$(familyId)/petbox_requests/$(requestId));
      let petAfter = getAfter(/databases/$(database)/documents/families/$(familyId)/petbox_requests/$(requestId));
      return pet != null && pet.data.status == 'pending' && pet.data.childId == childId
        && petAfter != null && petAfter.data.status == 'approved'
        && data.lastTransferTxId == petAfter.data.approvalTxId
        && data.balance == legacyBalance - pet.data.amountPence;
    }

    function isValidWalletCreate(familyId, childId) {
      let data = request.resource.data;
      let child = getAfter(/databases/$(database)/documents/users/$(childId));
      let legacyBalance = child == null ? 0 : child.data.get('walletBalance', 0);
      return isParent(familyId) && child != null && child.data.role == 'child' && child.data.familyId == familyId
        && data.keys().hasOnly(['balance', 'createdAt', 'migratedFromLegacy', 'lastTransferTxId', 'lastTransferReqId', 'lastManualTxId', 'lastFundTxId'])
        && data.balance is int && data.migratedFromLegacy == true && data.createdAt == request.time
        && (
          isValidWalletMigrationCreate(familyId, childId, legacyBalance)
          || isValidManualWalletCreate(familyId, childId, legacyBalance)
          || (data.keys().hasOnly(['balance', 'createdAt', 'migratedFromLegacy', 'lastTransferTxId', 'lastTransferReqId'])
            && (isValidTransferWalletCreate(familyId, childId, legacyBalance)
              || isValidMoneyWalletCreate(familyId, childId, legacyBalance)
              || isValidPetWalletCreate(familyId, childId, legacyBalance)))
        );
    }

    function isValidFundDonationInjection(familyId, fundId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let diff = data.diff(oldData).affectedKeys();
      let txId = data.get('lastFundTxId', 'null');
      let tx = getAfter(/databases/$(database)/documents/families/$(familyId)/fund_transactions/$(txId));
      let requestId = tx == null ? 'null' : tx.data.get('sourceId', 'null');
      let req = getAfter(/databases/$(database)/documents/families/$(familyId)/petbox_requests/$(requestId));

      return 'lastFundTxId' in data
        && diff.hasOnly(['balance', 'lastFundTxId'])
        && tx != null
        && tx.data.amount == (data.balance - oldData.balance)
        && tx.data.amount > 0
        && tx.data.amount is int
        && tx.data.fundId == fundId
        && tx.data.type == 'contribution'
        && req != null && req.data.status == 'approved' && req.data.fundTransactionId == txId
        && tx.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(familyId)/fund_transactions/$(txId));
    }

    function isValidFundExpenseUpdate(familyId, fundId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let txId = data.get('lastFundTxId', 'null');
      let tx = getAfter(/databases/$(database)/documents/families/$(familyId)/fund_transactions/$(txId));
      return isParent(familyId)
        && data.diff(oldData).affectedKeys().hasOnly(['balance', 'lastFundTxId'])
        && tx != null && tx.data.type == 'expense' && tx.data.fundId == fundId
        && tx.data.familyId == familyId
        && tx.data.sourceId == txId && tx.data.actorId == authProfileId()
        && tx.data.amount is int && tx.data.amount > 0
        && data.balance == oldData.balance - tx.data.amount
        && tx.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/families/$(familyId)/fund_transactions/$(txId));
    }

    function isValidFundTransactionCreate(familyId, txId) {
      let data = request.resource.data;
      let fund = getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(data.get('fundId', 'null')));
      let requestId = data.get('sourceId', 'null');
      let pet = getAfter(/databases/$(database)/documents/families/$(familyId)/petbox_requests/$(requestId));
      return isParent(familyId) && fund != null && fund.data.lastFundTxId == txId
        && data.createdAt == request.time
        && (
          (data.type == 'expense' && data.sourceId == txId && data.actorId == authProfileId())
          || (data.type == 'contribution' && pet != null && pet.data.status == 'approved'
              && pet.data.fundTransactionId == txId && data.fromUserId == pet.data.childId && data.amount == pet.data.amountPence)
        );
    }

    function hasValidReversalActor(data, familyId) {
      let actor = get(/databases/$(database)/documents/users/$(authProfileId()));
      return isParent(familyId) && actor != null
        && data.actorId == authProfileId()
        && data.actorName == actor.data.displayName;
    }

    function sourceSnapshotMatches(familyId, kind, sourceId, snapshot) {
      return (kind == 'wallet_transaction'
          && exists(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(sourceId))
          && get(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(sourceId)).data.get('effectSnapshot', null) == snapshot)
        || (kind == 'fund_transaction'
          && exists(/databases/$(database)/documents/families/$(familyId)/fund_transactions/$(sourceId))
          && get(/databases/$(database)/documents/families/$(familyId)/fund_transactions/$(sourceId)).data.get('effectSnapshot', null) == snapshot)
        || (kind == 'behaviour_event'
          && exists(/databases/$(database)/documents/families/$(familyId)/behaviour_events/$(sourceId))
          && get(/databases/$(database)/documents/families/$(familyId)/behaviour_events/$(sourceId)).data.get('effectSnapshot', null) == snapshot)
        || (kind == 'task_completion'
          && exists(/databases/$(database)/documents/families/$(familyId)/task_completions/$(sourceId))
          && get(/databases/$(database)/documents/families/$(familyId)/task_completions/$(sourceId)).data.get('effectSnapshot', null) == snapshot)
        || (kind == 'reward_redemption'
          && exists(/databases/$(database)/documents/families/$(familyId)/redemptions/$(sourceId))
          && get(/databases/$(database)/documents/families/$(familyId)/redemptions/$(sourceId)).data.get('effectSnapshot', null) == snapshot)
        || (kind == 'transfer_request'
          && exists(/databases/$(database)/documents/families/$(familyId)/transfer_requests/$(sourceId))
          && get(/databases/$(database)/documents/families/$(familyId)/transfer_requests/$(sourceId)).data.get('effectSnapshot', null) == snapshot)
        || (kind == 'money_request'
          && exists(/databases/$(database)/documents/families/$(familyId)/money_requests/$(sourceId))
          && get(/databases/$(database)/documents/families/$(familyId)/money_requests/$(sourceId)).data.get('effectSnapshot', null) == snapshot)
        || (kind == 'petbox_request'
          && exists(/databases/$(database)/documents/families/$(familyId)/petbox_requests/$(sourceId))
          && get(/databases/$(database)/documents/families/$(familyId)/petbox_requests/$(sourceId)).data.get('effectSnapshot', null) == snapshot);
    }

    function isExactInverse(original, inverse, familyId, actorId) {
      return inverse.keys().hasOnly(['schemaVersion', 'entityType', 'familyId', 'actorId', 'childId', 'counterpartyChildId', 'fundId', 'walletDeltaPence', 'counterpartyWalletDeltaPence', 'fundDeltaPence', 'pointsDelta', 'xpAdjustment'])
        && inverse.schemaVersion == 1 && inverse.entityType == 'reversal'
        && inverse.familyId == familyId && inverse.actorId == actorId && inverse.xpAdjustment == 0
        && inverse.get('childId', '') == original.get('childId', '')
        && inverse.get('counterpartyChildId', '') == original.get('counterpartyChildId', '')
        && inverse.get('fundId', '') == original.get('fundId', '')
        && inverse.get('walletDeltaPence', 0) == (0 - original.get('walletDeltaPence', 0))
        && inverse.get('counterpartyWalletDeltaPence', 0) == (0 - original.get('counterpartyWalletDeltaPence', 0))
        && inverse.get('fundDeltaPence', 0) == (0 - original.get('fundDeltaPence', 0))
        && inverse.get('pointsDelta', 0) == (0 - original.get('pointsDelta', 0));
    }

    function isValidReversalRecord(familyId, reversalId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['familyId', 'sourceKind', 'sourceId', 'reversalId', 'actorId', 'actorName', 'reason', 'status', 'originalEffectSnapshot', 'inverseEffectSnapshot', 'xpAdjustment', 'xpReversed', 'completedAt'])
        && data.keys().hasAll(['familyId', 'sourceKind', 'sourceId', 'reversalId', 'actorId', 'actorName', 'reason', 'status', 'originalEffectSnapshot', 'inverseEffectSnapshot', 'xpAdjustment', 'xpReversed', 'completedAt'])
        && data.familyId == familyId && data.reversalId == reversalId
        && reversalId == data.sourceKind + '__' + data.sourceId
        && data.sourceKind in ['wallet_transaction', 'fund_transaction', 'behaviour_event', 'task_completion', 'reward_redemption', 'transfer_request', 'money_request', 'petbox_request']
        && hasValidReversalActor(data, familyId)
        && data.reason is string && data.reason.trim().size() > 0
        && data.status == 'completed' && data.xpAdjustment == 0 && data.xpReversed == false
        && data.completedAt == request.time
        && data.originalEffectSnapshot is map && data.inverseEffectSnapshot is map
        && data.originalEffectSnapshot.familyId == familyId && data.originalEffectSnapshot.schemaVersion == 1
        && data.originalEffectSnapshot.xpAdjustment == 0
        && sourceSnapshotMatches(familyId, data.sourceKind, data.sourceId, data.originalEffectSnapshot)
        && isExactInverse(data.originalEffectSnapshot, data.inverseEffectSnapshot, familyId, authProfileId());
    }

    function isValidReversalEvent(familyId, reversalId) {
      let data = request.resource.data;
      let reversal = getAfter(/databases/$(database)/documents/families/$(familyId)/reversals/$(reversalId));
      return reversal != null
        && data.keys().hasOnly(['familyId', 'sourceKind', 'sourceId', 'reversalId', 'actorId', 'actorName', 'reason', 'effectSnapshot', 'xpAdjustment', 'xpReversed', 'createdAt'])
        && data.familyId == familyId && data.reversalId == reversalId
        && data.sourceKind == reversal.data.sourceKind && data.sourceId == reversal.data.sourceId
        && data.actorId == authProfileId() && data.actorName == reversal.data.actorName
        && data.reason == reversal.data.reason && data.effectSnapshot == reversal.data.inverseEffectSnapshot
        && data.xpAdjustment == 0 && data.xpReversed == false && data.createdAt == request.time;
    }

    function isValidReversalWalletUpdate(familyId, childId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let reversalId = data.get('lastReversalId', 'null');
      let reversal = getAfter(/databases/$(database)/documents/families/$(familyId)/reversals/$(reversalId));
      let original = reversal == null ? {} : reversal.data.originalEffectSnapshot;
      let inverse = reversal == null ? {} : reversal.data.inverseEffectSnapshot;
      let isPrimary = original.get('childId', '') == childId && 'walletDeltaPence' in original;
      let suffix = isPrimary ? '__wallet' : '__counterparty';
      let expected = isPrimary ? inverse.get('walletDeltaPence', 0) : inverse.get('counterpartyWalletDeltaPence', 0);
      return reversal != null && reversal.data.actorId == authProfileId()
        && data.diff(oldData).affectedKeys().hasOnly(['balance', 'lastReversalId'])
        && ((isPrimary) || (original.get('counterpartyChildId', '') == childId && 'counterpartyWalletDeltaPence' in original))
        && data.balance == oldData.balance + expected
        && data.balance >= get(/databases/$(database)/documents/families/$(familyId)).data.get('debtLimitPence', -5000)
        && existsAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(reversalId + suffix));
    }

    function isValidReversalWalletLedger(familyId, txId) {
      let data = request.resource.data;
      let reversal = getAfter(/databases/$(database)/documents/families/$(familyId)/reversals/$(data.get('reversalId', 'null')));
      let original = reversal == null ? {} : reversal.data.originalEffectSnapshot;
      let inverse = reversal == null ? {} : reversal.data.inverseEffectSnapshot;
      let primary = txId == data.reversalId + '__wallet' && data.childId == original.get('childId', '') && data.amountPence == inverse.get('walletDeltaPence', 0);
      let counterparty = txId == data.reversalId + '__counterparty' && data.childId == original.get('counterpartyChildId', '') && data.amountPence == inverse.get('counterpartyWalletDeltaPence', 0);
      return reversal != null && data.keys().hasOnly(['type', 'familyId', 'sourceKind', 'sourceId', 'reversalId', 'actorId', 'actorName', 'childId', 'amountPence', 'effectSnapshot', 'createdAt'])
        && data.type == 'reversal' && data.familyId == familyId
        && data.sourceKind == reversal.data.sourceKind && data.sourceId == reversal.data.sourceId
        && data.actorId == authProfileId() && data.actorName == reversal.data.actorName
        && data.effectSnapshot == reversal.data.inverseEffectSnapshot && data.createdAt == request.time
        && (primary || counterparty);
    }

    function isValidReversalFundUpdate(familyId, fundId) {
      let data = request.resource.data;
      let oldData = resource.data;
      let reversalId = data.get('lastReversalId', 'null');
      let reversal = getAfter(/databases/$(database)/documents/families/$(familyId)/reversals/$(reversalId));
      return reversal != null && reversal.data.actorId == authProfileId()
        && reversal.data.originalEffectSnapshot.get('fundId', '') == fundId
        && data.diff(oldData).affectedKeys().hasOnly(['balance', 'lastReversalId'])
        && data.balance == oldData.balance + reversal.data.inverseEffectSnapshot.get('fundDeltaPence', 0)
        && existsAfter(/databases/$(database)/documents/families/$(familyId)/fund_transactions/$(reversalId + '__fund'));
    }

    function isValidReversalFundLedger(familyId, txId) {
      let data = request.resource.data;
      let reversal = getAfter(/databases/$(database)/documents/families/$(familyId)/reversals/$(data.get('reversalId', 'null')));
      return reversal != null && txId == data.reversalId + '__fund'
        && data.keys().hasOnly(['type', 'familyId', 'sourceKind', 'sourceId', 'reversalId', 'actorId', 'actorName', 'fundId', 'amount', 'effectSnapshot', 'createdAt'])
        && data.type == 'reversal' && data.familyId == familyId
        && data.fundId == reversal.data.originalEffectSnapshot.get('fundId', '')
        && data.amount == reversal.data.inverseEffectSnapshot.get('fundDeltaPence', 0)
        && data.sourceKind == reversal.data.sourceKind && data.sourceId == reversal.data.sourceId
        && data.actorId == authProfileId() && data.actorName == reversal.data.actorName
        && data.effectSnapshot == reversal.data.inverseEffectSnapshot && data.createdAt == request.time;
    }

    function isValidReversalPointsUpdate(uid) {
      let data = request.resource.data;
      let oldData = resource.data;
      let familyId = oldData.get('familyId', 'null');
      let reversalId = data.get('lastReversalId', 'null');
      let reversal = getAfter(/databases/$(database)/documents/families/$(familyId)/reversals/$(reversalId));
      return reversal != null && reversal.data.actorId == authProfileId()
        && reversal.data.originalEffectSnapshot.get('childId', '') == uid
        && 'pointsDelta' in reversal.data.originalEffectSnapshot
        && data.diff(oldData).affectedKeys().hasOnly(['rewardPoints', 'lastReversalId'])
        && data.get('rewardPoints', 0) == oldData.get('rewardPoints', 0) + reversal.data.inverseEffectSnapshot.get('pointsDelta', 0)
        && data.get('rewardPoints', 0) >= 0;
    }

    function isValidSelfSignup(uid) {
      let data = request.resource.data;
      return authProfileId() == uid
        && data.uid == uid
        && data.role == 'parent'
        && !('familyId' in data);
    }

    function isValidManagedMemberCreate(uid) {
      let data = request.resource.data;
      return data.uid == uid
        && data.get('familyId', '') != ''
        && data.isManaged == true
        && (data.role == 'parent' || data.role == 'child')
        && isOwner(data.familyId);
    }

    function isValidOwnerBootstrap(uid) {
      let data = request.resource.data;
      let familyId = data.get('familyId', 'null');
      let familyPath = /databases/$(database)/documents/families/$(familyId);

      return authProfileId() == uid
        && !('familyId' in resource.data) // Must not have a family yet
        && resource.data.get('role', 'null') == 'parent'
        && data.get('uid', 'null') == uid
        && data.get('role', 'null') == 'owner'
        && familyId != 'null'
        && !exists(familyPath)
        && existsAfter(familyPath);
    }

    function isValidJoinProfileUpdate(uid) {
      let data = request.resource.data;
      let familyId = data.get('familyId', 'null');
      let requestId = data.get('joinRequestId', 'null');
      let req = get(/databases/$(database)/documents/families/$(familyId)/join_requests/$(requestId));
      let reqAfter = getAfter(/databases/$(database)/documents/families/$(familyId)/join_requests/$(requestId));
      return isOwner(familyId) && !('familyId' in resource.data)
        && req != null && req.data.status == 'pending' && req.data.uid == uid
        && reqAfter != null && reqAfter.data.status == 'approved' && reqAfter.data.assignedRole == data.get('role', 'null')
        && data.get('uid', 'null') == uid && data.get('displayName', 'null') == req.data.displayName
        && data.get('role', 'null') in ['parent', 'child']
        && data.diff(resource.data).affectedKeys().hasOnly(['uid', 'joinRequestId', 'familyId', 'role', 'displayName', 'avatarUrl', 'rewardPoints', 'lifetimeXP', 'currentStreak', 'longestStreak', 'lastActiveDate'])
        && data.get('rewardPoints', -1) == 0 && data.get('lifetimeXP', -1) == 0
        && data.get('currentStreak', -1) == 0 && data.get('longestStreak', -1) == 0 && data.get('lastActiveDate', 'null') == request.time;
    }

    function hasValidJoinApproval(familyId, requestId, oldData, data) {
      let user = getAfter(/databases/$(database)/documents/users/$(oldData.get('uid', 'null')));
      let wallet = getAfter(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.get('uid', 'null')));
      let feed = getAfter(/databases/$(database)/documents/families/$(familyId)/feed/$(('join_') + requestId));
      return user != null && user.data.get('uid', 'null') == oldData.get('uid', 'null') && user.data.get('joinRequestId', 'null') == requestId
        && user.data.get('familyId', 'null') == familyId && user.data.get('role', 'null') == data.get('assignedRole', 'null')
        && user.data.get('displayName', 'null') == oldData.get('displayName', 'null')
        && (data.get('assignedRole', 'null') == 'parent' || (wallet != null && wallet.data.get('balance', -1) == 0))
        && feed != null && feed.data.get('actorId', 'null') == authProfileId();
    }

    function isValidTransferApproval(familyId, requestId, data, oldData) {
      let txId = data.approvalTxId;
      let txOut = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId + '_out'));
      let txIn = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId + '_in'));
      let senderWallet = getAfter(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.fromChildId));
      let recipientWallet = getAfter(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.toChildId));

      let oldSenderWallet = get(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.fromChildId));
      let senderLegacy = get(/databases/$(database)/documents/users/$(oldData.fromChildId)).data.get('walletBalance', 0);
      let oldSenderBalance = oldSenderWallet == null ? senderLegacy : oldSenderWallet.data.balance;

      let oldRecipientWallet = get(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.toChildId));
      let recipientLegacy = get(/databases/$(database)/documents/users/$(oldData.toChildId)).data.get('walletBalance', 0);
      let oldRecipientBalance = oldRecipientWallet == null ? recipientLegacy : oldRecipientWallet.data.balance;

      return txOut != null && txIn != null
        && senderWallet != null && recipientWallet != null
        && senderWallet.data.lastTransferReqId == requestId
        && recipientWallet.data.lastTransferReqId == requestId
        && senderWallet.data.lastTransferTxId == txId + '_out'
        && recipientWallet.data.lastTransferTxId == txId + '_in'
        && senderWallet.data.balance == oldSenderBalance - oldData.amountPence
        && recipientWallet.data.balance == oldRecipientBalance + oldData.amountPence
        && txOut.data.approvalTxId == txId
        && txIn.data.approvalTxId == txId
        && txOut.data.transferRequestId == requestId
        && txIn.data.transferRequestId == requestId
        && txOut.data.amountPence == (0 - oldData.amountPence)
        && txIn.data.amountPence == oldData.amountPence
        && data.reviewedBy == authProfileId()
        && data.reviewedAt == request.time;
    }

    function isValidMoneyRequestApproval(familyId, requestId, data, oldData) {
      let txId = data.paymentTransferId;
      let source = get(/databases/$(database)/documents/users/$(oldData.requestedFromId));
      let requesterWallet = getAfter(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.requesterId));
      let oldRequesterWallet = get(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.requesterId));
      let requesterLegacy = get(/databases/$(database)/documents/users/$(oldData.requesterId)).data.get('walletBalance', 0);
      let oldRequesterBalance = oldRequesterWallet == null ? requesterLegacy : oldRequesterWallet.data.balance;
      let txIn = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId + '_in'));
      let sourceIsParent = source != null && (source.data.role == 'parent' || source.data.role == 'owner');
      return requesterWallet != null && txIn != null
        && requesterWallet.data.lastTransferReqId == requestId
        && requesterWallet.data.lastTransferTxId == txId + '_in'
        && requesterWallet.data.balance == oldRequesterBalance + oldData.amountPence
        && txIn.data.moneyRequestId == requestId && txIn.data.approvalTxId == txId
        && txIn.data.amountPence == oldData.amountPence
        && data.reviewedBy == authProfileId() && data.reviewedAt == request.time
        && (sourceIsParent || (
          getAfter(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.requestedFromId)) != null
          && getAfter(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.requestedFromId)).data.lastTransferReqId == requestId
          && getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId + '_out')) != null
          && getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId + '_out')).data.moneyRequestId == requestId
          && getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(txId + '_out')).data.approvalTxId == txId
        ));
    }

    function isValidPetBoxApproval(familyId, data, oldData) {
      let wallet = getAfter(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.childId));
      let fund = getAfter(/databases/$(database)/documents/families/$(familyId)/funds/$(oldData.fundId));
      let walletTx = getAfter(/databases/$(database)/documents/families/$(familyId)/wallet_transactions/$(data.approvalTxId));
      let fundTx = getAfter(/databases/$(database)/documents/families/$(familyId)/fund_transactions/$(data.fundTransactionId));
      let oldWallet = get(/databases/$(database)/documents/families/$(familyId)/wallets/$(oldData.childId));
      let walletLegacy = get(/databases/$(database)/documents/users/$(oldData.childId)).data.get('walletBalance', 0);
      let oldWalletBalance = oldWallet == null ? walletLegacy : oldWallet.data.balance;
      let oldFund = get(/databases/$(database)/documents/families/$(familyId)/funds/$(oldData.fundId));
      return wallet != null && fund != null && walletTx != null && fundTx != null
        && wallet.data.lastTransferTxId == data.approvalTxId
        && wallet.data.balance == oldWalletBalance - oldData.amountPence
        && walletTx.data.type == 'petbox_donation' && walletTx.data.childId == oldData.childId
        && walletTx.data.amountPence == (0 - oldData.amountPence)
        && fund.data.lastFundTxId == data.fundTransactionId
        && oldFund != null && fund.data.balance == oldFund.data.balance + oldData.amountPence
        && fundTx.data.fundId == oldData.fundId && fundTx.data.fromUserId == oldData.childId
        && fundTx.data.amount == oldData.amountPence && fundTx.data.type == 'contribution'
        && data.reviewedBy == authProfileId() && data.reviewedAt == request.time;
    }


    // =========================================================================
    // GOALS (Phase 2) — focused, additive security layer on top of the existing
    // permissive `savings_goals` legacy match. These helpers enforce the v1
    // Goals trust model WITHOUT weakening or refactoring any existing wallet,
    // transfer, Pet Box, auth, notification, or other financial validators.
    //
    // Design invariants enforced here:
    //  - Children never directly mutate wallet balances, goal currentAmountPence,
    //    goal terminal status, match proposals, approval decisions, or ledger entries.
    //  - Financial balance changes only occur in the exact trusted transaction
    //    shapes implemented in Phase 1 (see api.ts).
    //  - Contributions and goal_ledger entries are create-only and immutable.
    //  - Idempotency operation documents are NOT client-writable. They are written
    //    only by the trusted backend transaction (Admin SDK / server context) and
    //    are never creatable, readable, updatable, or deletable by any client.
    //  - Cross-family access is always denied (familyId scoping + isFamilyMember).
    //  - reached -> active only via the trusted withdrawal transaction shape; an
    //    isolated parent write that decreases the goal balance without the full
    //    trusted batch is denied (see security boundary note on the rule).
    //  - completed_purchased / completed_returned / cancelled goals must have
    //    currentAmountPence == 0 and reject future financial writes.
    //
    // NOTE: Firestore Rules functions may only contain `let` bindings and a
    // single boolean return expression; control-flow `if`/`return` statements are
    // NOT permitted inside function bodies. All Goals helpers below are therefore
    // written as pure boolean expressions.
    // =========================================================================

    function isV1Goal(data) {
      return data.keys().hasAny(['version', 'currentAmountPence', 'matching'])
        && data.get('version', 0) == 1;
    }

    function isTerminalGoal(status) {
      return status in ['completed_purchased', 'completed_returned', 'cancelled'];
    }

    // SECURITY BOUNDARY (atomic initial parent contribution proof — fix(goals)):
    // A goal created with currentAmountPence > 0 MUST be backed by an immutable
    // parent_contribution leg + matching goal_ledger entry + goal_create
    // idempotency doc, all written in the SAME client batch. This is now enforced
    // AT THE RULES LAYER (the trust boundary) using getAfter()/existsAfter() in
    // the goal CREATE rule, NOT merely trusted to the client transaction.
    //
    // DIAGNOSIS OF PRIOR "Service call error": the previous code asserted that
    // getAfter()/existsAfter() throw "Service call error" inside CREATE rules in
    // the Firebase Emulator Suite. This was empirically FALSE for the emulator in
    // use (firebase-tools 15.22.1 / 15.23.0, Firestore emulator standard edition):
    // a minimal CREATE rule using existsAfter()/getAfter() on a deterministically
    // addressed sibling document SUCCEEDS. The earlier failure was caused by
    // NON-DETERMINISTIC document ids (the contribution/ledger ids were derived from
    // an auto-generated goal doc id that is NOT present in request.resource.data),
    // so the rule could not construct a resolvable path — producing a path/access
    // error, not a fundamental getAfter limitation. The fix makes every document
    // in the atomic create addressable from request.resource.data:
    //   - goal doc id            == data.goalId
    //   - contribution leg       == contributions/initialParentContribution
    //   - ledger entry           == goal_ledger/initialParentLedger
    //   - idempotency doc        == idempotency/goalCreate_<data.clientReqId>
    // The rule then verifies familyId/goalId/actorId/clientReqId/amount equality
    // across all three sibling docs. A direct client write that forges a non-zero
    // balance without the matching legs is DENIED at the boundary.
    function isValidGoalCreate(familyId) {
      let data = request.resource.data;
      return data.keys().hasAll(['goalId', 'title', 'kind', 'targetAmountPence', 'currentAmountPence', 'currency', 'status', 'matching', 'createdBy', 'createdAt', 'version', 'clientReqId'])
        && data.keys().hasOnly(['goalId', 'title', 'kind', 'childId', 'targetAmountPence', 'currentAmountPence', 'currency', 'status', 'matching', 'createdBy', 'createdByName', 'createdAt', 'version', 'clientReqId'])
        && data.version == 1
        && data.currentAmountPence >= 0
        && data.status in ['active', 'reached']
        && data.targetAmountPence is int && data.targetAmountPence > 0
        && data.currency is string
        && data.createdAt == request.time
        && data.createdBy == authProfileId()
        && data.clientReqId is string && data.clientReqId.size() > 0
        && (
          (isParent(familyId) && data.kind in ['family', 'child'])
          || (isChildInFamily(familyId, authProfileId())
              && data.kind == 'child'
              && data.childId == authProfileId())
        )
        && (data.kind != 'child' || isChildInFamily(familyId, data.get('childId', 'null')))
        && data.matching is map
        && data.matching.keys().hasOnly(['mode', 'perX', 'matchY', 'capPence'])
        && data.matching.mode in ['none', 'auto', 'manual']
        && data.matching.perX is int && data.matching.matchY is int;
    }

    // Atomic seed proof for a non-zero initial balance. Verifies, via getAfter(),
    // that the SAME batch wrote the deterministic parent_contribution leg, the
    // matching goal_ledger entry, and the goal_create idempotency doc, all with
    // the exact same familyId/goalId/actorId/clientReqId/amount. Kept lean (3
    // getAfter calls + equality checks) to stay well under the per-request
    // access-call and expression limits.
    function isValidSeededGoalCreate(familyId, goalId) {
      let data = request.resource.data;
      let idemKey = 'goalCreate_' + data.clientReqId;
      let contribPath = /databases/$(database)/documents/families/$(familyId)/savings_goals/$(goalId)/contributions/initialParentContribution;
      let ledgerPath = /databases/$(database)/documents/families/$(familyId)/savings_goals/$(goalId)/goal_ledger/initialParentLedger;
      let idemPath = /databases/$(database)/documents/families/$(familyId)/idempotency/$(idemKey);
      // NOTE: getAfter(...).exists() is NOT a valid method in this emulator's
      // rules engine (it throws "Function not found error: Name: [exists]"). The
      // correct, working form is the top-level existsAfter(path) function. This is
      // the actual root cause of the prior "Service call error" — NOT that
      // getAfter/existsAfter are unavailable in CREATE rules. Both existAfter() and
      // getAfter().data.X work correctly inside CREATE rules in this emulator.
      return existsAfter(contribPath)
        && getAfter(contribPath).data.type == 'parent_contribution'
        && getAfter(contribPath).data.goalId == goalId
        && getAfter(contribPath).data.ownerId == authProfileId()
        && getAfter(contribPath).data.amountPence == data.currentAmountPence
        && getAfter(contribPath).data.status == 'applied'
        && existsAfter(ledgerPath)
        && getAfter(ledgerPath).data.type == 'parent_contribution'
        && getAfter(ledgerPath).data.goalId == goalId
        && getAfter(ledgerPath).data.ownerId == authProfileId()
        && getAfter(ledgerPath).data.amountPence == data.currentAmountPence
        && existsAfter(idemPath)
        && getAfter(idemPath).data.operationType == 'goal_create'
        && getAfter(idemPath).data.actorId == authProfileId()
        && getAfter(idemPath).data.goalId == goalId
        && getAfter(idemPath).data.amountPence == data.currentAmountPence
        && getAfter(idemPath).data.clientReqId == data.clientReqId;
    }

    // SECURITY BOUNDARY (reached -> active):
    // Firestore Rules cannot atomically link a goal update to the sibling
    // goal_requests / goal_ledger / wallet documents written in the same client
    // batch, because get()/getAfter() inside a rule only see committed state, not
    // pending batch writes. We therefore CANNOT prove, at the rule layer, that a
    // reached->active decrease is accompanied by the complete trusted withdrawal
    // batch (approved request + goal_return ledger + wallet credit + contribution
    // leg). The rule below enforces the *shape* of the transition (parent-only,
    // decrease-only, no extra fields) but the authoritative linkage to
    // goal_requests is enforced server-side in api.ts (the trusted transaction
    // reads the approved request, writes the goal_return ledger, credits the
    // wallet, and only then flips the goal). To prevent an isolated parent from
    // arbitrarily reducing a goal balance with NO corresponding wallet credit, the
    // wallet credit itself is gated by the trusted ledger shapes, and a bare goal
    // balance decrease that is not part of the trusted batch leaves the wallet
    // inconsistent. The complete trusted batch shape is the ONLY path that
    // produces a consistent, rule-permitted state; a malicious isolated parent
    // write that decreases the goal without the wallet credit is denied at the
    // wallet layer (the wallet credit requires the trusted withdrawal ledger), so
    // the goal decrease alone cannot be paired with a forged wallet credit.
    // Goal update validators are SPLIT into separate functions OR'd in the allow
    // rule so Firestore's || short-circuiting avoids evaluating every branch for
    // each write. A child contribution only evaluates isValidGoalChildContribution;
    // the heavier parent/terminal/metadata branches are skipped. This is what keeps
    // the multi-write Goals transaction under the 1000-expression limit.
    // Single combined goal update validator. Performs EXACTLY ONE get() (the
    // actor user doc) and ONE diff(), and handles every allowed v1 transition
    // (child contribution, parent terminal-lock, reached->active, metadata,
    // money-increase, completion, return) inside one function. This keeps the
    // update allow rule at a single get() + single diff() so it stays under the
    // Firestore 1000-expression limit. The previous design spread these across
    // isValidGoalChildContribution / isValidGoalParentUpdate /
    // isValidGoalReturnUpdate (each with its own get()/diff()), and the
    // fully-expanded OR tree exceeded the limit — producing an "evaluation
    // error" on the reached->active path instead of a clean allow/deny. The
    // goal doc carries no familyId field, so family scoping is already enforced
    // by the match block (no redundant get-pair).
    function isValidGoalChildContribution(familyId, goalId) {
      let data = request.resource.data;
      let old = resource.data;
      let diff = data.diff(old).affectedKeys();
      return diff.hasOnly(['currentAmountPence', 'status'])
        && old.status in ['active', 'reached']
        && data.currentAmountPence is int
        && data.currentAmountPence >= old.currentAmountPence
        && (data.status == old.status || (old.status == 'active' && data.status == 'reached'))
        && authProfileId() == old.get('childId', 'null')
        && data.get('familyId', old.get('familyId', 'null')) == old.get('familyId', 'null');
    }

    function isValidGoalParentUpdate(familyId, goalId) {
      let data = request.resource.data;
      let old = resource.data;
      let diff = data.diff(old).affectedKeys();
      let familyImmutable = data.get('familyId', old.get('familyId', 'null')) == old.get('familyId', 'null');
      let terminalLocked = isTerminalGoal(old.status)
        ? (old.currentAmountPence == 0 && data.currentAmountPence == 0
            && diff.hasOnly(['status', 'completedMode', 'completedAt', 'completedBy'])
            && data.status == old.status)
        : false;
      let reachedToActive = (old.status == 'reached' && data.status == 'active')
        ? (diff.hasOnly(['currentAmountPence', 'status'])
            && data.currentAmountPence is int
            && data.currentAmountPence < old.currentAmountPence
            && data.currentAmountPence >= 0)
        : false;
      let metadataOnly = diff.hasOnly(['title', 'currency', 'matching', 'targetAmountPence'])
        ? (data.matching is map
            && data.matching.keys().hasOnly(['mode', 'perX', 'matchY', 'capPence'])
            && data.matching.mode in ['none', 'auto', 'manual']
            && data.matching.perX is int && data.matching.matchY is int
            && data.targetAmountPence is int && data.targetAmountPence > 0)
        : false;
      let moneyIncrease = diff.hasOnly(['currentAmountPence', 'status'])
        && old.status in ['active', 'reached']
        && data.currentAmountPence is int
        && data.currentAmountPence >= old.currentAmountPence
        && (data.status == old.status || (old.status == 'active' && data.status == 'reached'));
      let completion = diff.hasOnly(['currentAmountPence', 'status', 'completedMode', 'completedAt', 'completedBy'])
        && old.status in ['active', 'reached']
        && data.status == 'completed_purchased'
        && data.currentAmountPence == old.currentAmountPence;
      return isParent(familyId) && familyImmutable
        && (terminalLocked || reachedToActive || metadataOnly || moneyIncrease || completion);
    }

    // Lean validator for the goal document update performed by returnGoalFunds /
    // cancelGoal. It only permits the terminal transition to completed_returned /
    // cancelled with currentAmountPence == 0. Kept separate from
    // isValidGoalParentUpdate (no isParent get(), no heavy diff() branching) so the
    // multi-write return transaction stays under the 1000-expression limit.
    function isValidGoalReturnUpdate(familyId, goalId) {
      let data = request.resource.data;
      let old = resource.data;
      // Lean terminal-transition validator for returnGoalFunds / cancelGoal.
      // Permits ONLY the transition to completed_returned / cancelled with
      // currentAmountPence == 0. Uses request.resource.data.status (the NEW
      // status being written) — NOT resource.data.status (the old status) — so
      // the terminal branch is correctly selected and the multi-write return
      // transaction stays under Firestore's 1000-expression budget. The API
      // already enforces parent-only access, but we ALSO require isParent here
      // for defense-in-depth (a child must never be able to complete/cancel a
      // goal). familyId is immutable and may be absent on legacy/seed docs, so
      // we do NOT assert it here. The parent/match closure is recorded as an
      // immutable external_closure contribution leg, never as a scalar on the
      // goal doc, so no closedExternalPence field is required here.
      return isParent(familyId)
        && old.status in ['active', 'reached']
        && data.status in ['completed_returned', 'cancelled']
        && data.currentAmountPence == 0;
    }

    // Lean validator for the goal-display-document DELETE performed by
    // deleteCancelledGoal. A goal may be hard-deleted ONLY when it is a cancelled,
    // zero-balance goal owned by the same family. Children can NEVER delete goals.
    // The actual money/fund/proposal checks are enforced server-side in api.ts; the
    // rule here is an independent, defense-in-depth boundary that refuses any delete
    // of an active/reached/completed goal or any goal with remaining funds, and
    // refuses deletes by non-parent/owner callers. Subcollections (contributions,
    // goal_ledger, match_proposals) are NOT deletable (see their own allow rules).
    function isValidGoalDelete(familyId) {
      return isParent(familyId)
        && resource.data.status == 'cancelled'
        && resource.data.currentAmountPence == 0;
    }

    // Lean validator for the auto_match contribution leg written by the Goals
    // transaction. Auto-match is deterministic from the child's contribution and
    // represents parent funds; it is written by the funding parent OR by the child
    // who triggered it (ownerId == actorId). Kept separate from
    // isValidContributionCreate so the (heavier) general validator is NOT evaluated
    // for the auto_match leg — this keeps the per-request expression budget under
    // the 1000-expression limit for the multi-write Goals transaction.
    function isValidAutoMatchContributionCreate(familyId, goalId) {
      let data = request.resource.data;
      // Auto-match is written by the child who triggered the contribution
      // (ownerId == actorId == authProfileId()); shape + ownership prove validity,
      // so no isParent get() is needed here (keeps the transaction under 1000 exp).
      return data.type == 'auto_match'
        && data.ownerType == 'parent'
        && data.keys().hasOnly(['contribId', 'goalId', 'type', 'ownerType', 'ownerId', 'amountPence', 'matchPence', 'sourceContributionId', 'status', 'createdBy', 'createdAt'])
        && data.goalId == goalId
        && data.status == 'applied'
        && data.createdAt == request.time
        && data.amountPence is int && data.matchPence is int
        && 'sourceContributionId' in data
        && data.ownerId == authProfileId();
    }

    // Contribution create validators are SPLIT by owner so Firestore's || short-
    // circuits and only the relevant branch is evaluated per write. The child
    // contribution leg in the Goals transaction only evaluates
    // isValidChildContributionCreate (no isParent get(), fewer keys), keeping the
    // multi-write transaction under the 1000-expression limit. auto_match is
    // handled by isValidAutoMatchContributionCreate (separate, lean).
    function isValidChildContributionCreate(familyId, goalId) {
      let data = request.resource.data;
      return data.type in ['child_contribution', 'child_withdrawal', 'completion_refund']
        && data.ownerType == 'child'
        && data.ownerId == authProfileId()
        && data.keys().hasOnly(['contribId', 'goalId', 'type', 'ownerType', 'ownerId', 'amountPence', 'matchPence', 'sourceContributionId', 'walletTxId', 'status', 'createdBy', 'createdAt'])
        && data.goalId == goalId
        && data.status == 'applied'
        && data.createdAt == request.time
        && data.amountPence is int;
    }

    function isValidParentContributionCreate(familyId, goalId) {
      let data = request.resource.data;
      return isParent(familyId)
        && data.type in ['parent_contribution', 'manual_match']
        && data.ownerType == 'parent'
        && data.ownerId == authProfileId()
        && data.keys().hasOnly(['contribId', 'goalId', 'type', 'ownerType', 'ownerId', 'amountPence', 'matchPence', 'sourceContributionId', 'proposedMatchAmountPence', 'sourceRequestId', 'status', 'createdBy', 'createdAt'])
        && data.goalId == goalId
        && data.status == 'applied'
        && data.createdAt == request.time
        && data.amountPence is int
        && (data.type != 'manual_match' || 'sourceContributionId' in data);
    }

    // Lean validator for the goal_ledger create (immutable append-only ledger).
    // Lean validator for the completion_refund contribution leg written by the
    // parent during returnGoalFunds / cancelGoal. The parent (actor) writes a
    // completion_refund on behalf of each refunded child (ownerId == child,
    // ownerType == 'child'); the child is NOT the actor. Shape + parent ownership
    // prove validity, so no child-equality check is needed here. Kept separate
    // (lean, single isParent get()) so the multi-write return transaction stays
    // under Firestore's 1000-expression budget.
    function isValidCompletionRefundCreate(familyId, goalId) {
      let data = request.resource.data;
      return isParent(familyId)
        && data.type == 'completion_refund'
        && data.ownerType == 'child'
        && data.keys().hasOnly(['contribId', 'goalId', 'type', 'ownerType', 'ownerId', 'amountPence', 'matchPence', 'sourceContributionId', 'walletTxId', 'status', 'createdBy', 'createdAt'])
        && data.goalId == goalId
        && data.status == 'applied'
        && data.createdAt == request.time
        && data.amountPence is int;
    }

    // Lean validator for the external_closure contribution leg written by the
    // parent during returnGoalFunds / cancelGoal. It closes the parent/match
    // portions that are NOT wallet-credited (immutable, never a scalar on the
    // goal doc). Shape + parent ownership prove validity. Kept separate (lean,
    // single isParent get()) so the multi-write return transaction stays under
    // Firestore's 1000-expression budget.
    function isValidExternalClosureCreate(familyId, goalId) {
      let data = request.resource.data;
      return isParent(familyId)
        && data.type == 'external_closure'
        && data.ownerType == 'parent'
        && data.ownerId == authProfileId()
        && data.keys().hasOnly(['contribId', 'goalId', 'type', 'ownerType', 'ownerId', 'amountPence', 'matchPence', 'sourceContributionId', 'status', 'createdBy', 'createdAt'])
        && data.goalId == goalId
        && data.status == 'applied'
        && data.createdAt == request.time
        && data.amountPence is int;
    }

    function isValidGoalLedgerCreate(familyId, goalId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['entryId', 'goalId', 'type', 'amountPence', 'ownerId', 'createdAt', 'note'])
        && data.goalId == goalId
        && data.createdAt == request.time
        && data.amountPence is int
        && data.type in ['child_contribution', 'parent_contribution', 'auto_match', 'manual_match', 'child_withdrawal', 'completion_refund', 'external_closure'];
    }

    function isValidMatchProposalCreate(familyId, goalId) {
      let data = request.resource.data;
      let requiredKeys = ['proposalId', 'goalId', 'sourceContributionId', 'proposedMatchAmountPence', 'status', 'createdAt'];
      return data.keys().hasAll(requiredKeys)
        && data.keys().hasOnly(['proposalId', 'goalId', 'sourceContributionId', 'proposedMatchAmountPence', 'status', 'createdBy', 'createdAt'])
        && data.goalId == goalId
        && data.status == 'proposed'
        && data.proposedMatchAmountPence is int && data.proposedMatchAmountPence >= 0
        && data.createdAt == request.time
        && isParent(familyId);
    }

    function isValidMatchProposalUpdate(familyId) {
      let data = request.resource.data;
      let old = resource.data;
      let diff = data.diff(old).affectedKeys();
      let immutableKept = data.goalId == old.goalId
        && data.sourceContributionId == old.sourceContributionId
        && data.proposedMatchAmountPence == old.proposedMatchAmountPence;
      return isParent(familyId)
        && immutableKept
        && old.status == 'proposed'
        && data.status in ['approved', 'rejected']
        && diff.hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt'])
        && data.reviewedBy == authProfileId()
        && data.reviewedAt == request.time;
    }

    function isValidGoalRequestCreate(familyId) {
      let data = request.resource.data;
      let requiredKeys = ['requestType', 'goalId', 'childId', 'amountPence', 'status', 'createdAt'];
      return data.keys().hasAll(requiredKeys)
        && data.keys().hasOnly(['requestType', 'goalId', 'childId', 'amountPence', 'status', 'createdBy', 'createdAt', 'dedupeKey'])
        && data.familyId == familyId
        && data.status == 'pending'
        && data.amountPence is int && data.amountPence > 0
        && data.createdAt == request.time
        && data.requestType in ['contribution', 'withdrawal']
        && (data.requestType != 'withdrawal' || (data.childId == authProfileId() && isChildInFamily(familyId, authProfileId())))
        && (data.requestType != 'contribution' || (data.childId == authProfileId() && isChildInFamily(familyId, authProfileId())));
    }

    function isValidGoalRequestUpdate(familyId) {
      let data = request.resource.data;
      let old = resource.data;
      let diff = data.diff(old).affectedKeys();
      let parentOnly = isParent(familyId) && old.status == 'pending';
      let rejectedShape = data.status == 'rejected'
        ? (data.rejectionReason is string)
        : (data.contribId is string && data.walletTxId is string);
      return parentOnly
        && data.status in ['approved', 'rejected']
        && diff.hasOnly(['status', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'rejectionReason', 'contribId', 'walletTxId'])
        && data.reviewedBy == authProfileId()
        && data.reviewedAt == request.time
        && rejectedShape;
    }

    // Idempotency operation documents (families/{familyId}/idempotency/{operationKey}).
    // Written ONLY by the trusted backend transaction (Admin SDK / server context)
    // as part of an atomic money-moving operation. NEVER client-writable: no client
    // (parent, owner, or child) may create, read, update, or delete them. The match
    // block below denies ALL client access, which denies an isolated forged
    // "completed" operation document. This helper documents the exact trusted shape
    // for reference (used server-side, not by client rules) so the rule and the API
    // cannot drift.
    function isValidIdempotencyOperation(familyId, operationKey) {
      let data = request.resource.data;
      // Lean shape check kept minimal to fit the multi-write Goals transaction
      // under the 1000-expression limit. Regex matches() is avoided (very
      // expensive in the rules expression budget); the operationType allow-list
      // uses `in` (cheap) and denies the colon-form forged doc from the
      // anti-forgery test (operationType "goalContribution" != "goal_contribution").
      return data.operationType in ['goal_create', 'goal_contribution', 'goal_contribution_request', 'goal_parent_contribution', 'goal_withdrawal_request', 'goal_withdrawal_approve', 'goal_purchased', 'goal_returned', 'goal_cancelled', 'goal_deleted', 'goal_match_approve']
        && data.status == 'completed'
        && data.createdAt == request.time
        && data.expiresAt == request.time;
    }

    // =========================================================================
    // GAMIFICATION PHASE 1 — HELPER FUNCTIONS
    // =========================================================================
    // These helpers support the gamification security model:
    // - Migration state machine: inactive -> prepared -> baseline_complete -> active
    // - Server-only collections for immutable gamification data
    // - Daily Goal percentage validation (50-100 integer)
    // =========================================================================

    function gamificationMigrationStatus(familyId) {
      let family = get(/databases/$(database)/documents/families/$(familyId));
      return family == null ? 'inactive' : family.data.get('gamificationMigration.status', 'inactive');
    }

    function isGamificationActive() {
      return gamificationMigrationStatus(resource.data.familyId) in ['prepared', 'baseline_complete', 'active'];
    }

    function isValidDailyGoalPercentage(value) {
      return value is int && value >= 50 && value <= 100;
    }

    function isValidLanguage(value) {
      return value is string && value in ['en', 'tr'];
    }

    function isValidGamificationConfig(data) {
      return data.keys().hasOnly(['schemaVersion', 'dailyGoalPercentage'])
        && data.schemaVersion == 1
        && isValidDailyGoalPercentage(data.dailyGoalPercentage);
    }

    // USERS
    match /users/{uid} {
      // Cross-member profile reads follow the family lifecycle freeze: while a
      // family is deleting (or its document is gone) only self reads and the
      // managed-child identity lookup remain.
      allow read: if isAuthenticated() && (
        authProfileId() == uid
        || isManagedChildIdentity(uid)
        || (familyIsActive(resource.data.get('familyId', 'null'))
          && get(/databases/$(database)/documents/users/$(authProfileId())).data.familyId == resource.data.familyId)
      );

      allow update: if isAuthenticated() && (
        isValidReversalPointsUpdate(uid) ||
        (authProfileId() == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['language'])
          && isValidLanguage(request.resource.data.language)) ||
        (authProfileId() == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'familyId', 'rewardPoints', 'lifetimeXP', 'walletBalance', 'balance', 'lastFundTxId',
          'displayName', 'avatarUrl', 'avatarId', 'language',
          // Phase 1 child-login linking fields: server-only (Admin SDK). A client
          // must never be able to set its own login link, username, or flags.
          'hasLogin', 'username', 'loginEnabled', 'requiresPasswordChange', 'authUid'
        ])) ||
        // Owner/parent may self-edit only their own benign profile fields.
        // Children are not isParent, so they remain routed through the approval flow.
        (isParent(resource.data.familyId) && authProfileId() == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'avatarId'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastRedemptionId']) && isValidRedemptionDeduction(uid))
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastTaskCompletionId']) && isValidTaskApprovalMutation(uid))
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastBehaviourEventId']) && isValidBehaviourPointMutation(uid)) ||
        (!('familyId' in resource.data) && 'familyId' in request.resource.data ? isValidOwnerBootstrap(uid) || isValidJoinProfileUpdate(uid) : false) ||
        ('familyId' in resource.data && isOwner(resource.data.familyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) && resource.data.get('role', 'null') != 'child' && request.resource.data.role != 'child') ||
        ('familyId' in resource.data && isParent(resource.data.familyId) && resource.data.get('role', 'null') == 'child' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarUrl', 'avatarId']))
      );

      allow create: if isAuthenticated() && (
        isValidSelfSignup(uid) ||
        isValidManagedMemberCreate(uid)
      );

      allow delete: if false;
    }

    // SERVER-ONLY FAMILY/ACCOUNT DELETION COLLECTIONS
    // Deletion jobs and receipts are owned exclusively by Cloud Functions.
    // Clients must never read or write them.
    // Child join request infrastructure (root, server-owned). The lookup maps
    // an opaque requestId to a familyId for the unauthenticated status/cancel
    // callables; the rate-limit counters back abuse protection. Neither is ever
    // client readable or writable — the Admin SDK is the only writer.
    match /childJoinRequestLookup/{requestId} {
      allow read, write: if false;
    }
    match /childJoinRateLimits/{limitKey} {
      allow read, write: if false;
    }

    match /familyDeletionJobs/{jobId} {
      allow read, write: if false;
    }
    match /familyDeletionReceipts/{receiptId} {
      allow read, write: if false;
    }
    match /accountDeletionJobs/{jobId} {
      allow read, write: if false;
    }

    // FAMILIES
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create: if isAuthenticated();
      allow update: if isOwner(familyId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['inviteCode'])
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'lifecycleState', 'deletionJobId', 'deletionRequestedAt', 'deletionRequestedBy'
        ])
        && (!('gamificationConfig' in request.resource.data)
            || isValidGamificationConfig(request.resource.data.gamificationConfig))
        && (!('petBoxEnabled' in request.resource.data)
            || request.resource.data.petBoxEnabled is bool)
        // The setup audit block is validated only when this write actually
        // changes it. It pins completedAt == request.time, so re-validating an
        // untouched, previously-approved setup map would reject every later
        // owner update (regional settings, name, Pet Box, ...).
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['setup'])
            || isValidFamilySetup(request.resource.data.setup));

      // Role-authoritative invitation records. Written exclusively by the
      // trusted backend (createFamilyInvitation / acceptInvitation) and never
      // readable by clients — the validated projection is returned by the
      // previewInvitation callable instead, so no family information leaks
      // before the invitation has been validated.
      match /invitations/{inviteCode} {
        allow read, write: if false;
      }

      match /join_requests/{requestId} {
        // Creation is server-authoritative: the callable resolves the private
        // family code with Admin SDK and writes the request without a role.
        allow create: if false;
        allow update: if isOwner(familyId) && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == authProfileId()
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assignedRole', 'rejectionReason', 'reviewedBy', 'reviewedByName', 'reviewedAt'])
          // When the request originated from an invitation, the server stamped
          // an intendedRole on it. The approving owner may accept or reject,
          // but may NOT change the role the invitation granted.
          && (request.resource.data.status != 'approved'
              || !('intendedRole' in resource.data)
              || request.resource.data.get('assignedRole', 'null') == resource.data.intendedRole)
          && ((request.resource.data.status == 'rejected' && request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.trim().size() > 0)
              || hasValidJoinApproval(familyId, requestId, resource.data, request.resource.data));
        allow read: if isFamilyMember(familyId) || (isAuthenticated() && resource.data.uid == authProfileId());
        allow delete: if false;
      }

      match /announcements/{announcementId} {
        allow read: if canReadAnnouncement(familyId, resource.data);
        allow create: if isValidAnnouncementCreate(familyId);
        allow update: if isParent(familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'message', 'type', 'audienceType', 'audienceUserIds', 'priority',
            'startsAt', 'expiresAt', 'pinned', 'status', 'linkedTaskId',
            'linkedRewardId', 'linkedSettingChangeId', 'updatedAt'
          ])
          && request.resource.data.type in ['general', 'rule_change', 'consequence', 'new_task', 'reward_update', 'event', 'urgent']
          && request.resource.data.audienceType in ['family', 'children', 'adults', 'selected']
          && request.resource.data.priority in ['normal', 'important', 'urgent']
          && request.resource.data.status in ['active', 'archived']
          && request.resource.data.audienceUserIds is list
          && request.resource.data.audienceUserIds.size() <= 50
          && ((request.resource.data.audienceType == 'selected' && request.resource.data.audienceUserIds.size() > 0)
              || (request.resource.data.audienceType != 'selected' && request.resource.data.audienceUserIds.size() == 0))
          && request.resource.data.title is string
          && request.resource.data.title.trim().size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.message is string
          && request.resource.data.message.trim().size() > 0
          && request.resource.data.message.size() <= 2000
          && request.resource.data.pinned is bool
          && (!('startsAt' in request.resource.data) || request.resource.data.startsAt is timestamp)
          && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is timestamp)
          && (!('startsAt' in request.resource.data) || !('expiresAt' in request.resource.data)
              || request.resource.data.expiresAt > request.resource.data.startsAt)
          && hasValidAnnouncementLinks(familyId, request.resource.data);
        allow delete: if isParent(familyId);
      }

      match /announcement_reads/{readId} {
        allow read: if isFamilyMember(familyId)
          && (resource.data.userId == authProfileId() || isParent(familyId));
        allow create: if isFamilyMember(familyId)
          && request.resource.data.keys().hasOnly(['familyId', 'announcementId', 'userId', 'readAt'])
          && request.resource.data.familyId == familyId
          && request.resource.data.userId == authProfileId()
          && readId == request.resource.data.announcementId + '_' + authProfileId()
          && request.resource.data.readAt == request.time
          && exists(/databases/$(database)/documents/families/$(familyId)/announcements/$(request.resource.data.announcementId))
          && canReadAnnouncement(
            familyId,
            get(/databases/$(database)/documents/families/$(familyId)/announcements/$(request.resource.data.announcementId)).data
          );
        allow update: if isFamilyMember(familyId)
          && request.resource.data.familyId == resource.data.familyId
          && request.resource.data.announcementId == resource.data.announcementId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userId == authProfileId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }

      match /tasks/{taskId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isParent(familyId);
      }

      match /task_completions/{completionId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId);
        allow update: if (isParent(familyId) && resource.data.status == 'pending_approval'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == authProfileId()
          && request.resource.data.reviewedAt == request.time
          && ((request.resource.data.status == 'approved'
              && request.resource.data.approvedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'parentComment', 'approvedAt', 'reviewedBy', 'reviewedByName', 'reviewedAt']))
            || (request.resource.data.status == 'rejected'
              && request.resource.data.rejectedAt == request.time
              && request.resource.data.parentComment is string && request.resource.data.parentComment.trim().size() > 0
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'parentComment', 'rejectedAt', 'reviewedBy', 'reviewedByName', 'reviewedAt']))))
          || (isAuthenticated() && resource.data.status == 'pending_approval' && (resource.data.assigneeId == authProfileId() || isParent(familyId))
              && request.resource.data.status == 'cancelled' && request.resource.data.cancelledBy == authProfileId()
              && request.resource.data.cancelledAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelledAt']));
        allow delete: if false;
      }

      match /behaviour_events/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow create: if familyIsActive(familyId) && isBehaviourManager(familyId) && isValidBehaviourEvent(familyId);
        allow update, delete: if false;
      }

      match /rewards/{rewardId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isParent(familyId);
      }

      match /redemptions/{redemptionId} {
        allow read: if isParent(familyId) || (isAuthenticated() && resource.data.userId == authProfileId());
        allow create: if isFamilyMember(familyId)
          && request.resource.data.keys().hasAll(['rewardId', 'userId', 'costPaid', 'redeemedAt', 'createdAt', 'status', 'familyId', 'sourceId', 'actorId', 'effectSnapshot'])
          && request.resource.data.keys().hasOnly(['rewardId', 'userId', 'costPaid', 'redeemedAt', 'createdAt', 'status', 'familyId', 'sourceId', 'actorId', 'effectSnapshot'])
          && request.resource.data.userId == authProfileId()
          && request.resource.data.familyId == familyId && request.resource.data.sourceId == redemptionId
          && request.resource.data.actorId == authProfileId() && hasCanonicalEffectSnapshot(request.resource.data, familyId)
          && request.resource.data.effectSnapshot.childId == authProfileId()
          && request.resource.data.effectSnapshot.rewardId == request.resource.data.rewardId
          && request.resource.data.effectSnapshot.pointsDelta == (0 - request.resource.data.costPaid)
          && request.resource.data.costPaid is int && request.resource.data.costPaid > 0
          && request.resource.data.redeemedAt == request.time && request.resource.data.createdAt == request.time
          && request.resource.data.status == 'completed'
          && isValidRedemptionCreate(familyId, redemptionId);
        allow update, delete: if false;
      }

      match /wallets/{childId} {
        allow read: if isParent(familyId) || (isAuthenticated() && authProfileId() == childId);
        allow create: if isValidWalletCreate(familyId, childId);
        // 8-function chain (matches previously-deployed d7a75cf) preserves the
        // per-type wallet-balance authorization guarantees. The goal_return case
        // (lastGoalTxId, parent credits child) is added as a lean branch so the
        // Goals return transaction stays within the 1000-expression budget.
        // The behaviour-penalty deduction is ISOLATED into its own allow statement
        // (regression fix): it is now read-free (see isValidBehaviourPenalty-
        // Deduction), so a second allow statement adds only a cheap evaluation
        // and keeps the parent penalty log under Firestore's 1000-expression
        // budget. The client must supply lastPenaltyTxId (fixed in api.ts
        // addBehaviourEvent).
        allow update: if familyIsActive(familyId) && (
          isValidDepositCredit(familyId, childId)
          || isValidReversalWalletUpdate(familyId, childId)
          || isValidWithdrawalDeduction(familyId, childId)
          || isValidParentTransferDeduction(familyId, childId)
          || isValidParentTransferCredit(familyId, childId)
          || isValidPetBoxDonationDeduction(familyId, childId)
          || (isParentRaw(familyId) && isValidLedgerSync(familyId, childId))
          || (isParentRaw(familyId) && 'lastGoalTxId' in request.resource.data
              && request.resource.data.balance is int
              && request.resource.data.keys().hasOnly(['balance', 'lastGoalTxId'])));
        // Isolated, read-free penalty deduction (lean) so the parent penalty
        // log transaction stays within the 1000-expression budget.
        allow update: if familyIsActive(familyId) && isValidBehaviourPenaltyDeduction(familyId, childId);
      }

      match /wallet_transactions/{txId} {
        allow read: if isParent(familyId) || (isAuthenticated() && resource.data.childId == authProfileId());
        // Goals ledger legs (goal_contribution / goal_return) are validated by lean
        // shape-only functions in a SEPARATE allow statement, isolated from the
        // heavy per-type non-Goals validator block below so each stays within
        // Firestore's 1000-expression budget. The goal_return transaction also
        // updates the child wallet with lastGoalTxId (validated by isValidWalletUpdate
        // on the wallets doc), so keeping this statement lean is essential.
        allow create: if familyIsActive(familyId)
          && ((request.resource.data.type == 'goal_contribution' && isValidGoalWalletLedger(familyId, txId))
          || (request.resource.data.type == 'goal_return' && isValidGoalReturnWalletLedger(familyId, txId)));
        // Reversal + non-Goals writes require a behaviour manager (parent/owner) and
        // are validated per-type by the existing isValid*Ledger functions, preserving
        // the authorization and ledger-shape guarantees of the previously-deployed rules.
        // SECURITY FIX (regression from Goals merge): the Goals merge had dropped the
        // isBehaviourManager gate and the per-type validators from this branch, leaving
        // any authenticated family member able to forge arbitrary wallet_txn legs.
        // The financial_penalty ledger is ISOLATED into its own allow statement
        // (regression fix): isValidFinancialPenalty does a getAfter on the linked
        // behaviour event and reads it many times, and OR'ing it inside this heavy
        // isBehaviourManager chain pushed the per-request evaluation over Firestore's
        // 1000-expression limit, denying every parent penalty log.
        allow create: if familyIsActive(familyId) && (request.resource.data.type == 'financial_penalty' && isValidFinancialPenalty(familyId));
        allow create: if familyIsActive(familyId) && ((request.resource.data.type == 'reversal' && isValidReversalWalletLedger(familyId, txId)) || (isBehaviourManager(familyId) && (
            (request.resource.data.type == 'deposit' && request.resource.data.amount > 0 && request.resource.data.amount is int && isChildInFamily(familyId, request.resource.data.childId) && request.resource.data.parentRef == authProfileId() && request.resource.data.createdAt == request.time) ||
            (request.resource.data.type == 'withdrawal' && request.resource.data.amount > 0 && request.resource.data.amount is int && isChildInFamily(familyId, request.resource.data.childId) && request.resource.data.parentRef == authProfileId() && request.resource.data.createdAt == request.time) ||
            (request.resource.data.type == 'transfer' && request.resource.data.amount > 0 && request.resource.data.amount is int && isChildInFamily(familyId, request.resource.data.childId) && isChildInFamily(familyId, request.resource.data.fromChildId) && request.resource.data.parentRef == authProfileId() && request.resource.data.createdAt == request.time) ||
            (request.resource.data.type == 'transfer_out' && ('transferRequestId' in request.resource.data ? isValidTransferOutLedger(familyId) : isValidMoneyRequestOutLedger(familyId))) ||
            (request.resource.data.type == 'transfer_in' && ('transferRequestId' in request.resource.data ? isValidTransferInLedger(familyId) : isValidMoneyRequestInLedger(familyId))) ||
            (request.resource.data.type == 'request_payment' && isValidMoneyRequestPaymentLedger(familyId)) ||
            (request.resource.data.type == 'petbox_donation' && isValidPetBoxWalletLedger(familyId, txId))
          )));
        allow update, delete: if false;
      }

      match /savings_goals/{goalId} {
        allow read: if isFamilyMember(familyId);
        // v1 goal create: shape-validated by isValidGoalCreate. A non-zero initial
        // balance MUST additionally prove the atomic seed linkage (parent_contribution
        // leg + goal_ledger entry + goal_create idempotency doc) via getAfter() in the
        // same batch; a zero-seeded goal requires no legs. Legacy (pre-v1) goals keep
        // the original permissive parent/self create for backwards compatibility.
        allow create: if isV1Goal(request.resource.data)
          ? (isValidGoalCreate(familyId)
             && (request.resource.data.currentAmountPence == 0
                 || isValidSeededGoalCreate(familyId, goalId)))
          : (isParent(familyId) || (isAuthenticated() && request.resource.data.childId == authProfileId()));
        allow update: if (isV1Goal(resource.data))
          ? (request.resource.data.status in ['completed_returned', 'cancelled']
              ? isValidGoalReturnUpdate(familyId, goalId)
              : (isValidGoalChildContribution(familyId, goalId)
                || isValidGoalParentUpdate(familyId, goalId)))
          : (isParent(familyId) || (isAuthenticated() && resource.data.childId == authProfileId()));
        // Strict delete guard: only a same-family parent/owner may delete a
        // CANCELLED, zero-balance goal. Active/reached/completed goals and goals
        // with remaining funds cannot be deleted. Children can never delete goals.
        // Accounting subcollections (contributions, goal_ledger, match_proposals)
        // remain non-deletable (their own allow rules below). This is the ONLY
        // goal-deletion path; the component never calls deleteDoc directly.
        allow delete: if isValidGoalDelete(familyId);

        match /contributions/{contribId} {
          allow read: if isFamilyMember(familyId);
          // Ownership is proven inside the validators (data.ownerId == authProfileId()
          // for child legs; isParent(familyId) && data.ownerId == authProfileId() for
          // parent legs), so the redundant isFamilyMember get() is omitted here to keep
          // the multi-write Goals transaction under the 1000-expression limit.
          allow create: if isValidChildContributionCreate(familyId, goalId)
            || isValidParentContributionCreate(familyId, goalId)
            || isValidAutoMatchContributionCreate(familyId, goalId)
            || isValidCompletionRefundCreate(familyId, goalId)
            || isValidExternalClosureCreate(familyId, goalId);
          allow update, delete: if false;
        }

        match /goal_ledger/{ledgerId} {
          allow read: if isFamilyMember(familyId);
          allow create: if isValidGoalLedgerCreate(familyId, goalId);
          allow update, delete: if false;
        }

        match /match_proposals/{proposalId} {
          allow read: if isFamilyMember(familyId);
          allow create: if isFamilyMember(familyId) && isValidMatchProposalCreate(familyId, goalId);
          allow update: if isValidMatchProposalUpdate(familyId);
          allow delete: if false;
        }
      }
      match /goal_requests/{requestId} {
        allow read: if isParent(familyId) || (isAuthenticated() && resource.data.childId == authProfileId());
        allow create: if isFamilyMember(familyId) && isValidGoalRequestCreate(familyId);
        allow update: if isValidGoalRequestUpdate(familyId);
        allow delete: if false;
      }

      // Idempotency operation documents. Written by the trusted goal transaction
      // (client SDK runTransaction) using the EXACT shape validated by
      // isValidIdempotencyOperation. Clients may ONLY create a document that
      // matches the trusted shape exactly (operationType in the underscore
      // allow-list, valid key prefix, all required fields, server timestamps).
      // A forged doc using the colon form for operationType (anti-forgery test)
      // is rejected. Reads are permitted for family members (replay detection);
      // update/delete remain denied.
      match /idempotency/{operationKey} {
        allow read: if isFamilyMember(familyId);
        allow create: if isValidIdempotencyOperation(familyId, operationKey);
        allow update, delete: if false;
      }

      match /feed/{feedId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.keys().hasOnly(['actorId', 'actorName', 'type', 'behaviourType', 'reason', 'pointsDelta', 'walletDelta', 'childId', 'text', 'entityType', 'entityId', 'visibleTo', 'createdAt', 'timestamp'])
          && request.resource.data.actorId == authProfileId()
          && (
            !('visibleTo' in request.resource.data) ||
            // Crash-safe: build the allowed set without indexing past the end of the list.
            // visibleTo may contain 0, 1 or 2 entries; the actor and optional childId are
            // always permitted in addition to the entries the client supplied.
            (request.resource.data.visibleTo is list && request.resource.data.visibleTo.hasOnly([request.resource.data.get('childId', ''), authProfileId()].concat(request.resource.data.get('visibleTo', []))))
          );
        allow update, delete: if isParent(familyId);
      }

      // In-app notifications. Per-recipient visibility is enforced by the read
      // rule (recipientIds membership + same-family). Content is immutable and
      // may only be created by a parent/owner, so children cannot forge
      // notifications or recipients. Read state is tracked separately per user.
      match /notifications/{notificationId} {
        function allowedKeys() {
          return ['familyId', 'type', 'actorId', 'recipientIds', 'title', 'body', 'entityType', 'entityId', 'actionUrl', 'dedupeKey', 'createdAt', 'metadata'];
        }
        // A non-existent document (e.g. a dedupe pre-read for a notification that
        // has not been written yet) must resolve to "no data" rather than throw a
        // Null value error. Existing notifications remain readable only by family
        // members listed in recipientIds.
        allow read: if resource == null
          || (isFamilyMember(familyId) && authProfileId() in resource.data.recipientIds);
        // Any authenticated family member may create a notification *as themselves*
        // (actorId == authProfileId()). Children legitimately originate notifications
        // (e.g. task_submitted, profile_update_requested) inside the same transaction as
        // the business event. The actor must be the caller and a family member; all field,
        // recipient-list and createdAt constraints below remain enforced so a child cannot
        // forge another actor, inject arbitrary fields, or back-date the document.
        allow create: if isFamilyMember(familyId)
          && request.resource.data.keys().hasOnly(allowedKeys())
          && request.resource.data.familyId == familyId
          && request.resource.data.actorId == authProfileId()
          && request.resource.data.recipientIds is list
          && request.resource.data.recipientIds.size() > 0
          && request.resource.data.recipientIds.size() <= 50
          && request.resource.data.createdAt == request.time;
        // Immutable after creation; no client deletes (retention handled server-side).
        allow update, delete: if false;
      }

      // Push tokens: per-user, per-device registration. Clients may only manage
      // tokens for their own uid and their current family. Raw tokens are never
      // exposed to other members, and identity fields are immutable after create.
      match /users/{userId} {
        match /push_tokens/{tokenId} {
          function allowedCreateKeys() {
            return ['userId', 'familyId', 'token', 'platform', 'browser', 'deviceLabel',
              'createdAt', 'updatedAt', 'lastSeenAt', 'enabled', 'permission', 'appVersion', 'userAgentSummary'];
          }
          function allowedUpdateKeys() {
            return ['enabled', 'permission', 'deviceLabel', 'updatedAt', 'lastSeenAt'];
          }
          // A non-existent document (e.g. the getDoc() pre-read during first-time
          // registration, when no token record exists yet) must resolve to "no
          // data" rather than throw a Null value error. Existing tokens remain
          // readable only by their owner. This mirrors the notifications read rule.
          allow read: if resource == null
            || (authProfileId() == userId
              && isFamilyMember(familyId)
              && resource.data.userId == authProfileId());
          allow create: if authProfileId() == userId
            && isFamilyMember(familyId)
            && request.resource.data.keys().hasOnly(allowedCreateKeys())
            && request.resource.data.userId == authProfileId()
            && request.resource.data.familyId == familyId
            && request.resource.data.token is string
            && request.resource.data.token.size() > 0
            && request.resource.data.token.size() <= 1000
            && request.resource.data.enabled == true
            && request.resource.data.permission == 'granted'
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.lastSeenAt == request.time;
          allow update: if authProfileId() == userId
            && isFamilyMember(familyId)
            && resource.data.userId == authProfileId()
            && resource.data.familyId == familyId
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.familyId == resource.data.familyId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedUpdateKeys())
            && request.resource.data.enabled is bool
            && request.resource.data.permission in ['default', 'granted', 'denied']
            && request.resource.data.updatedAt == request.time
            && request.resource.data.lastSeenAt == request.time
            // createdAt is immutable after create.
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if authProfileId() == userId
            && isFamilyMember(familyId)
            && resource.data.userId == authProfileId();
        }
      }

      // Push delivery records: written only by the trusted backend (Admin SDK).
      // Clients may read (diagnostics) but can never write.
      match /notification_deliveries/{notificationId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;
      }

      // Per-user read state. A user may only create/update their own record, and
      // only for a notification they are allowed to read. userId must equal the
      // authenticated uid and readAt must use request.time.
      match /notification_reads/{readId} {
        function allowedReadKeys() {
          return ['familyId', 'userId', 'notificationId', 'readAt'];
        }
        function notificationFor(nid) {
          return get(/databases/$(database)/documents/families/$(familyId)/notifications/$(nid));
        }
        allow read: if isFamilyMember(familyId) && resource.data.userId == authProfileId();
        allow create, update: if familyIsActive(familyId)
          && authProfileId() == request.resource.data.userId
          && request.resource.data.familyId == familyId
          && request.resource.data.keys().hasOnly(allowedReadKeys())
          // readAt is assigned server-side via serverTimestamp(); it is never a
          // client-supplied literal. Enforce that it is a timestamp (the
          // serverTimestamp sentinel resolves to a server timestamp in production)
          // rather than requiring exact equality with request.time, which a
          // serverTimestamp write can never satisfy and which previously rejected
          // every "mark all as read" batch with permission-denied.
          && request.resource.data.readAt is timestamp
          && notificationFor(request.resource.data.notificationId) != null
          && notificationFor(request.resource.data.notificationId).data.recipientIds.hasAll([authProfileId()]);
        allow delete: if false;
      }

      match /challenges/{challengeId} {
        allow read: if isFamilyMember(familyId);
        allow write: if isParent(familyId);
      }

      match /funds/{fundId} {
        allow read: if isFamilyMember(familyId);
        allow create: if petBoxEnabled(familyId) && isParent(familyId) && request.resource.data.balance == 0;
        allow update: if isValidReversalFundUpdate(familyId, fundId)
          || isValidFundDonationInjection(familyId, fundId)
          || (petBoxEnabled(familyId) && isValidFundExpenseUpdate(familyId, fundId));
        allow delete: if petBoxEnabled(familyId) && isParent(familyId);
      }

      match /fund_transactions/{txId} {
        allow read: if isFamilyMember(familyId);
        allow create: if (request.resource.data.type == 'reversal' && isValidReversalFundLedger(familyId, txId))
          || (request.resource.data.type == 'expense'
            ? petBoxEnabled(familyId) && isValidFundTransactionCreate(familyId, txId)
            : isValidFundTransactionCreate(familyId, txId));
        allow update, delete: if false;
      }

      match /reversal_events/{reversalId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isValidReversalEvent(familyId, reversalId);
        allow update, delete: if false;
      }

      match /reversals/{reversalId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isValidReversalRecord(familyId, reversalId);
        allow update, delete: if false;
      }

      match /transfer_requests/{requestId} {
        allow read: if isParent(familyId) || (isAuthenticated() && (resource.data.fromChildId == authProfileId() || resource.data.toChildId == authProfileId()));
        allow create: if isChildInFamily(familyId, authProfileId())
          && request.resource.data.keys().hasAll(['familyId', 'fromChildId', 'toChildId', 'amountPence', 'status', 'createdAt'])
          && request.resource.data.keys().hasOnly(['id', 'familyId', 'fromChildId', 'fromChildName', 'toChildId', 'toChildName', 'amountPence', 'message', 'status', 'createdAt'])
          && authProfileId() == request.resource.data.fromChildId
          && request.resource.data.familyId == familyId
          && isChildInFamily(familyId, request.resource.data.get('toChildId', 'null'))
          && request.resource.data.get('fromChildId', '') != request.resource.data.get('toChildId', '')
          && request.resource.data.amountPence is int
          && request.resource.data.amountPence > 0
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;

        allow update: if (isParent(familyId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == authProfileId()
          && request.resource.data.reviewedAt == request.time
          && (
            (request.resource.data.status == 'rejected' && request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.trim().size() > 0 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewedByName', 'rejectionReason']))
            ||
            (request.resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewedByName', 'approvalTxId', 'effectSnapshot'])
              && request.resource.data.get('approvalTxId', '') != ''
              && isValidTransferApproval(familyId, requestId, request.resource.data, resource.data)
            )
          ))
          || (isAuthenticated() && resource.data.status == 'pending' && (resource.data.fromChildId == authProfileId() || isParent(familyId))
              && request.resource.data.status == 'cancelled' && request.resource.data.cancelledBy == authProfileId()
              && request.resource.data.cancelledAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelledAt']));
        allow delete: if false;
      }

      match /money_requests/{requestId} {
        allow read: if isParent(familyId) || (isAuthenticated() && (resource.data.requesterId == authProfileId() || resource.data.requestedFromId == authProfileId()));
        allow create: if isFamilyMember(familyId)
          && request.resource.data.status in ['pending', 'pending_acceptance']
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/users/$(request.resource.data.requestedFromId)).data.familyId == familyId;
        allow update: if (isParent(familyId) && resource.data.status in ['pending', 'pending_acceptance']
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == authProfileId()
          && request.resource.data.reviewedAt == request.time
          && ((request.resource.data.status == 'rejected' && request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.trim().size() > 0 && request.resource.data.rejectionReason.size() <= 1000
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewedByName', 'rejectionReason']))
            || (request.resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewedByName', 'paymentTransferId', 'effectSnapshot'])
              && isValidMoneyRequestApproval(familyId, requestId, request.resource.data, resource.data))))
          || (isAuthenticated() && resource.data.status in ['pending', 'pending_acceptance'] && (resource.data.requesterId == authProfileId() || isParent(familyId))
              && request.resource.data.status == 'cancelled' && request.resource.data.cancelledBy == authProfileId()
              && request.resource.data.cancelledAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelledAt']))
          || (isAuthenticated() && resource.data.status == 'pending_acceptance' && resource.data.requestedFromId == authProfileId()
              && request.resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));
        allow delete: if false;
      }

      match /petbox_requests/{requestId} {
        allow read: if isParent(familyId) || (isAuthenticated() && resource.data.childId == authProfileId());
        allow create: if petBoxEnabled(familyId) && isChildInFamily(familyId, authProfileId())
          && request.resource.data.keys().hasAll(['familyId', 'fundId', 'fundName', 'childId', 'childName', 'amountPence', 'status', 'createdAt'])
          && request.resource.data.keys().hasOnly(['familyId', 'fundId', 'fundName', 'childId', 'childName', 'amountPence', 'status', 'createdAt'])
          && request.resource.data.familyId == familyId
          && request.resource.data.childId == authProfileId()
          && request.resource.data.amountPence is int && request.resource.data.amountPence > 0
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if petBoxEnabled(familyId) && ((isParent(familyId) && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == authProfileId()
          && request.resource.data.reviewedAt == request.time
          && ((request.resource.data.status == 'rejected' && request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.trim().size() > 0
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'rejectionReason']))
            || (request.resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'approvalTxId', 'fundTransactionId', 'effectSnapshot'])
              && isValidPetBoxApproval(familyId, request.resource.data, resource.data))))
          || (isAuthenticated() && resource.data.status == 'pending' && (resource.data.childId == authProfileId() || isParent(familyId))
              && request.resource.data.status == 'cancelled' && request.resource.data.cancelledBy == authProfileId()
              && request.resource.data.cancelledAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelledAt'])));
        allow delete: if false;
      }

      match /profile_update_requests/{requestId} {
        // A requested avatar is valid only when it is a starter avatar OR the
        // child already owns the premium avatar. Ownership is proven by the
        // existence of an avatar_unlocks document (read via get()). This prevents
        // a child from requesting an avatar they have not unlocked.
        function requestedAvatarIsAllowed() {
          let avatarId = request.resource.data.get('requestedAvatarId', '');
          // requestedAvatarId may be explicitly null (display-name-only change).
          // Coerce null to '' and only call exists() for a non-empty id, otherwise
          // exists() with a null document id throws and denies the entire create.
          return avatarId == null || avatarId == '' || isStarterAvatar(avatarId)
            || (avatarId != null && exists(/databases/$(database)/documents/families/$(familyId)/users/$(authProfileId())/avatar_unlocks/$(avatarId)));
        }
        allow read: if isParent(familyId) || (isAuthenticated() && resource.data.childId == authProfileId());
        allow create: if isChildInFamily(familyId, authProfileId())
          && request.resource.data.keys().hasAll(['familyId', 'childId', 'childName', 'requestedDisplayName', 'requestedAvatar', 'currentDisplayName', 'currentAvatar', 'status', 'createdAt', 'actorId'])
          && request.resource.data.keys().hasOnly(['familyId', 'childId', 'childName', 'requestedDisplayName', 'requestedAvatar', 'requestedAvatarId', 'currentDisplayName', 'currentAvatar', 'currentAvatarId', 'status', 'createdAt', 'actorId', 'id'])
          && request.resource.data.familyId == familyId
          && request.resource.data.childId == authProfileId()
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && requestedAvatarIsAllowed();
        allow update: if (isParent(familyId) && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.reviewedBy == authProfileId()
          && request.resource.data.reviewedAt == request.time
          && ((request.resource.data.status == 'rejected'
              && request.resource.data.rejectionReason is string
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewedByName', 'rejectionReason']))
            || (request.resource.data.status == 'approved'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewedByName', 'effectSnapshot']))))
          || (isAuthenticated() && resource.data.status == 'pending' && resource.data.childId == authProfileId()
              && request.resource.data.status == 'cancelled' && request.resource.data.cancelledBy == authProfileId()
              && request.resource.data.cancelledAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelledAt']));
        allow delete: if false;
      }

      // Avatar unlocks: immutable ownership records for premium avatars.
      // Starter avatars need no record. Premium unlocks are written only by the
      // owning child and the cost is validated server-side (see avatar_unlocks
      // helper). Clients cannot forge a cheaper cost or a free premium record.
      match /users/{userId} {
        match /avatar_unlocks/{avatarId} {
          function allowedKeys() {
            return ['avatarId', 'userId', 'familyId', 'unlockedAt', 'costPoints', 'source', 'actorId'];
          }
          allow read: if isFamilyMember(familyId) && (authProfileId() == userId || isParent(familyId));
          allow create: if authProfileId() == userId
            && isChildInFamily(familyId, userId)
            && request.resource.data.keys().hasOnly(allowedKeys())
            && request.resource.data.avatarId == avatarId
            && request.resource.data.userId == userId
            && request.resource.data.familyId == familyId
            && request.resource.data.actorId == userId
            && request.resource.data.source == 'points'
            && request.resource.data.unlockedAt == request.time
            // Cost must equal the authoritative catalog cost for this avatar.
            && request.resource.data.costPoints == avatarCatalogCost(avatarId)
            // The avatar must be a real, active, premium (points) avatar.
            && isPremiumAvatar(avatarId)
            // Prevent duplicate unlocks: the record must not already exist.
            && !exists(/databases/$(database)/documents/families/$(familyId)/users/$(userId)/avatar_unlocks/$(avatarId));
          // Immutable after creation.
          allow update, delete: if false;
        }
      }

      // =========================================================================
      // PARENT-CREATED CHILD LOGIN (Phase 1) — SERVER-OWNED COLLECTIONS
      // =========================================================================
      // These collections are written ONLY by the trusted backend (Admin SDK /
      // Cloud Functions) as part of createChildLogin / signInChild. They contain
      // the synthetic email, the Auth uid link, immutable audit events, and
      // idempotency records. Clients (parent, owner, or child) MUST NOT be able
      // to read or write any of them. The Admin SDK bypasses rules, so the
      // trusted backend remains the sole writer. This is defense-in-depth: even
      // a compromised client token cannot read the synthetic email or forge a
      // login record. We do NOT weaken any existing users/family/wallet/goals/
      // tasks/rewards rules by adding these.
      match /childLoginIndex/{normalizedUsername} {
        allow read, write: if false;
      }
      match /childLogins/{childId} {
        allow read, write: if false;
      }
      match /childLoginAudit/{auditId} {
        allow read, write: if false;
      }
      match /childLoginIdempotency/{clientReqId} {
        allow read, write: if false;
      }

      // =========================================================================
      // CHILD JOIN REQUESTS — PARENT-READABLE PROJECTION + SERVER-ONLY SECRETS
      // =========================================================================
      // A child who is not yet a member submits a join request from
      // /join-family. Until a parent of THIS family approves it, the request
      // grants zero family read/write access: no membership document exists, no
      // custom claims are issued, and the provisional Auth user is disabled.
      //
      // child_join_requests holds only the requested username, status and
      // timestamps so the Approval Center can render a card. It contains NO
      // family code and NO credential material, and it is written exclusively
      // by the trusted backend (approve/reject/expire/cancel callables).
      match /child_join_requests/{requestId} {
        allow read: if isParent(familyId);
        allow write: if false;
      }
      // Server-only sidecar: provisional Auth uid, synthetic email and the
      // hashed one-time request secret. Never readable by any client.
      match /childJoinSecrets/{requestId} {
        allow read, write: if false;
      }

      // =========================================================================
      // GAMIFICATION PHASE 1 — SERVER-OWNED COLLECTIONS
      // =========================================================================
      // These collections are written ONLY by the trusted backend (Admin SDK /
      // Cloud Functions) as part of the gamification processor. They contain
      // immutable occurrence reservations, event ledgers, eligibility snapshots,
      // daily progress projections, summary caches, and rebuild checkpoints.
      // Clients (parent, owner, or child) MUST NOT be able to read or write any
      // of them. The Admin SDK bypasses rules, so the trusted backend remains
      // the sole writer. This is defense-in-depth: even a compromised client
      // token cannot forge gamification data.
      //
      // Migration state machine: inactive -> prepared -> baseline_complete -> active
      // - inactive: task completion create/approval writes are DENIED
      // - prepared/baseline_complete/active: task completion state writes are ALLOWED
      // - All states: client rewardPoints/lifetimeXP writes on task completion are DENIED
      // =========================================================================

      // Server-only collections: task_occurrences, gamification_events, daily_eligibility,
      // daily_progress, gamification_summaries, gamification_checkpoints
      match /task_occurrences/{occurrenceId} {
        allow read, write: if false;
      }

      match /gamification_events/{eventId} {
        allow read, write: if false;
      }

      match /daily_eligibility/{eligibilityId} {
        allow read, write: if false;
      }

      match /daily_progress/{progressId} {
        // Parent/owner can read all family progress; child can read only own progress
        allow read: if isParent(familyId) || (isAuthenticated() && resource.data.childId == authProfileId());
        allow write: if false;
      }

      match /gamification_summaries/{summaryId} {
        // Parent/owner can read all family summaries; child can read only own summary
        allow read: if isParent(familyId) || (isAuthenticated() && summaryId == authProfileId());
        allow write: if false;
      }

      match /gamification_checkpoints/{checkpointId} {
        allow read, write: if false;
      }

      // =====================================================================
      // GAMIFICATION V3 — SHADOW COLLECTIONS (Phase 2)
      // =====================================================================
      // Written ONLY by the trusted backend (Admin SDK / Cloud Functions).
      // Clients must NEVER be able to create, update, or delete V3 ledger or
      // projection documents. Family members may read only according to existing
      // family boundaries and role requirements.
      //
      // TEMPORARY BRIDGE (amendment 1): These collections are written by the
      // Phase 2 shadow writer. Phase 3 must move trigger-backed flows to
      // server-authoritative callable/transaction paths before this bridge
      // is removed.
      // =====================================================================

      match /gamification_events_v3/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;
      }

      match /gamification_state_v3/{memberId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false;
      }

      match /gamification_v3_failures/{failureId} {
        allow read: if isParent(familyId);
        allow write: if false;
      }
    }
  }
}

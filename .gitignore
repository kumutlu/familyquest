# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Cloud Functions build output. Regenerated deterministically by
# `npm --prefix functions run build` (rm -rf lib && tsc), which Firebase runs
# as a hosting/functions predeploy step — it must never be committed.
functions/lib/
coverage
.firebase/
.worktrees/
*.local
family-data-exports/

# Local configuration and credentials
.env
.env.*
!.env.example

# Generated rule/debug evidence
*_output.txt
diff_output*.txt
part[0-9]*.txt
firestore.rules.backup
firestore.rules.bak*
firestore.rules.recovered
ruleset_name
latest_ruleset_name

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Firebase private credentials
firebase-key.json
*-firebase-adminsdk-*.json

# Generated test and browser reports
playwright-report/
test-results/

# Local environment files
.env
.env.local
# NOTE: .env.production is intentionally tracked (committed) — it holds only
# public Firebase Web SDK values and is required for deterministic production
# builds. Do NOT add it back to the ignore list.

# Temporary patches and backups
*.patch
*.backup

# Wallet snapshot artifacts (Task 0.4) — git-ignored local backup directory.
backups/wallet-snapshots/

# Gate 1 / replay generated artifacts (local emulator only, never production).
backups/gate1/
backups/exports/

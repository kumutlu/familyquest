# Queki — example environment file.
# Copy to `.env` (git-ignored) and fill real values locally. NEVER commit `.env`.
#
# ---------------------------------------------------------------------------
# Production smoke-test / disposable QA fixture credentials
# ---------------------------------------------------------------------------
# Used by:
#   scripts/smoke-setup.ts        (creates/refreshes the disposable fixture)
#   tests/e2e/production-smoke.spec.ts + playwright.prod.config.ts (live suite)
#
# These MUST be disposable QA-only accounts in familyquest-beta-402cb.
# Do NOT use real family accounts or real family data.
QUEKI_SMOKE_PARENT_EMAIL=qa-owner+smoke@queki.test
QUEKI_SMOKE_PARENT_PASSWORD=
QUEKI_SMOKE_CHILD_EMAIL=qa-child+smoke@queki.test
QUEKI_SMOKE_CHILD_PASSWORD=
# Optional: disposable unrelated-family adult for isolation checks.
QUEKI_SMOKE_UNRELATED_EMAIL=
QUEKI_SMOKE_UNRELATED_PASSWORD=
# Optional: family invite/join code for the disposable fixture family.
QUEKI_SMOKE_FAMILY_CODE=

# Base URL for the live smoke suite. Defaults to https://queki.app when unset.
# For local testing set to http://localhost:5174 and run the dev server yourself.
# QUEKI_SMOKE_BASE_URL=https://queki.app

# Admin SDK bootstrap for fixture setup/cleanup (path to service-account key).
# GOOGLE_APPLICATION_CREDENTIALS=./familyquest-beta-402cb-firebase-adminsdk.json
